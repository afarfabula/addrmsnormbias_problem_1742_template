// 本地多 case 单进程计时探针：同一进程内顺序对多个 case 计时（复现官方评测
// 调用形态，含 tiling 设备缓冲缓存在内容变化时重新上传的开销）。
// 用法: ./bench_multi <dirRootA> <dirRootB> ...   (env ARNBS_TIMES=500)
// 每个 dirRoot 下需存在 input/{case,x,residual,gamma,bias}.bin，
// 输出写到 dirRoot/output/output.bin（同现有 main.asc 约定）。
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include "acl/acl.h"
#include <vector>
#include <chrono>
#include "data_utils.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

struct CaseConfig {
    int64_t numDims;
    int64_t shape[8];
    int32_t dtype;
    float epsilon;
};

#include "kernel.asc"

static int RunOneCase(const char* root, int64_t coreNum, aclrtStream stream, int64_t times) {
    char path[1024];
    CaseConfig cfg;
    snprintf(path, sizeof(path), "%s/input/case.bin", root);
    FILE_CHECK(ReadFile(path, sizeof(CaseConfig), &cfg, sizeof(CaseConfig)));
    int64_t numDims = cfg.numDims;
    int64_t D = cfg.shape[numDims - 1];
    int64_t totalElems = 1;
    for (int64_t i = 0; i < numDims; i++) totalElems *= cfg.shape[i];
    int64_t dtypeSize = (cfg.dtype == 0) ? 4 : 2;
    size_t tensorBytes = static_cast<size_t>(totalElems) * static_cast<size_t>(dtypeSize);
    size_t paramBytes = static_cast<size_t>(D) * static_cast<size_t>(dtypeSize);
    fprintf(stderr, "[BENCH] %s D=%lld dtype=%d elems=%lld times=%lld\n", root, (long long)D, (int)cfg.dtype, (long long)totalElems, (long long)times);

    int64_t x_shape[8];
    for (int64_t i = 0; i < numDims; i++) x_shape[i] = cfg.shape[i];
    TensorInfo ti[] = {{x_shape, numDims, cfg.dtype}};
    TensorGroupInfo gx = {ti, 1};
    int64_t g_shape[8] = {D, 0};
    TensorInfo tg[] = {{g_shape, 1, cfg.dtype}};
    TensorGroupInfo gg = {tg, 1};

    uint8_t *hx=nullptr,*dx=nullptr,*hr=nullptr,*dr=nullptr,*hg=nullptr,*dg=nullptr;
    uint8_t *hb=nullptr,*db=nullptr,*ho=nullptr,*dout=nullptr;
    ACL_CHECK(aclrtMallocHost((void**)&hx, tensorBytes));
    ACL_CHECK(aclrtMalloc((void**)&dx, tensorBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMallocHost((void**)&hr, tensorBytes));
    ACL_CHECK(aclrtMalloc((void**)&dr, tensorBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMallocHost((void**)&hg, paramBytes));
    ACL_CHECK(aclrtMalloc((void**)&dg, paramBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMallocHost((void**)&hb, paramBytes));
    ACL_CHECK(aclrtMalloc((void**)&db, paramBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMallocHost((void**)&ho, tensorBytes));
    ACL_CHECK(aclrtMalloc((void**)&dout, tensorBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    snprintf(path, sizeof(path), "%s/input/x.bin", root);
    FILE_CHECK(ReadFile(path, tensorBytes, hx, tensorBytes));
    ACL_CHECK(aclrtMemcpy(dx, tensorBytes, hx, tensorBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    snprintf(path, sizeof(path), "%s/input/residual.bin", root);
    FILE_CHECK(ReadFile(path, tensorBytes, hr, tensorBytes));
    ACL_CHECK(aclrtMemcpy(dr, tensorBytes, hr, tensorBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    snprintf(path, sizeof(path), "%s/input/gamma.bin", root);
    FILE_CHECK(ReadFile(path, paramBytes, hg, paramBytes));
    ACL_CHECK(aclrtMemcpy(dg, paramBytes, hg, paramBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    snprintf(path, sizeof(path), "%s/input/bias.bin", root);
    FILE_CHECK(ReadFile(path, paramBytes, hb, paramBytes));
    ACL_CHECK(aclrtMemcpy(db, paramBytes, hb, paramBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    // 预热：先入队若干次确保首个 kernel 不进入计时
    for (int64_t w = 0; w < 5; w++) {
        run_kernel_nosync((GM_ADDR)dx, gx, (GM_ADDR)dr, gx, (GM_ADDR)dg, gg, (GM_ADDR)db, gg,
                          (GM_ADDR)dout, gx, coreNum, stream, cfg.epsilon);
    }
    ACL_CHECK(aclrtSynchronizeStream(stream));

    aclrtEvent evStart = nullptr, evEnd = nullptr;
    ACL_CHECK(aclrtCreateEvent(&evStart));
    ACL_CHECK(aclrtCreateEvent(&evEnd));
    ACL_CHECK(aclrtRecordEvent(evStart, stream));
    for (int64_t rep = 0; rep < times; rep++) {
        run_kernel_nosync((GM_ADDR)dx, gx, (GM_ADDR)dr, gx, (GM_ADDR)dg, gg, (GM_ADDR)db, gg,
                          (GM_ADDR)dout, gx, coreNum, stream, cfg.epsilon);
    }
    ACL_CHECK(aclrtRecordEvent(evEnd, stream));
    ACL_CHECK(aclrtSynchronizeEvent(evEnd));
    float devMs = 0.0f;
    ACL_CHECK(aclrtEventElapsedTime(&devMs, evStart, evEnd));
    fprintf(stderr, "[BENCH] %s dev_avg_us=%.2f (times=%lld)\n", root, devMs * 1000.0 / (double)times, (long long)times);

    snprintf(path, sizeof(path), "%s/output", root);
    { char cmd[1100]; snprintf(cmd, sizeof(cmd), "mkdir -p %s", path); if (system(cmd) != 0) { } }
    snprintf(path, sizeof(path), "%s/output/output.bin", root);
    ACL_CHECK(aclrtMemcpy(ho, tensorBytes, dout, tensorBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile(path, ho, tensorBytes));

    ACL_CHECK(aclrtDestroyEvent(evStart));
    ACL_CHECK(aclrtDestroyEvent(evEnd));
    aclrtFree(dx); aclrtFree(dr); aclrtFree(dg); aclrtFree(db); aclrtFree(dout);
    aclrtFreeHost(hx); aclrtFreeHost(hr); aclrtFreeHost(hg); aclrtFreeHost(hb); aclrtFreeHost(ho);
    return 0;
}

int main(int argc, char** argv) {
    if (argc < 2) { fprintf(stderr, "usage: bench_multi <dirRoot> ...\n"); return 2; }
    int64_t times = 300;
    const char* t = getenv("ARNBS_TIMES");
    if (t != nullptr && atoll(t) > 0) times = atoll(t);
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    int64_t coreNum = 0;
    ACL_CHECK(aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreNum));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));
    for (int i = 1; i < argc; i++) {
        int rc = RunOneCase(argv[i], coreNum, stream, times);
        if (rc != 0) return rc;
    }
    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(0));
    aclFinalize();
    fprintf(stderr, "[BENCH] all cases done\n");
    return 0;
}
