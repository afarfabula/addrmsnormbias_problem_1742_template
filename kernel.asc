// ============================================================================
// kernel.asc — AddRmsNormBias kernel（Ascend C 直调工程，第一版）
//
// 本文件被 main.asc include，同时包含 device 侧核函数与本进程的 host 侧
// 启动函数 run_kernel()。
//
// 计算逻辑（每个 row 沿最后一维 D 独立计算）：
//   y    = x + residual
//   rms  = sqrt(mean(y^2) + epsilon)
//   out  = y / rms * gamma + bias
//
// 精度策略：half / bfloat16 输入先升到 fp32 计算，最后一次性 round 回原类型，
// 与 golden（numpy fp32 实现）对齐。
//
// 并行策略：按 row 切分到多个 AIV core（blockNum <= availableCoreNum）；
// 单个 row 的 D 若大于 UB 容量，则按 CHUNK 列分片循环处理。
//
// 支持任意 D（含非 32B 对齐 tail，非整块部分用 DataCopyPad 搬运并填 0）；
// 更激进的流水/双缓冲留到后续版本。
// ============================================================================

#include <cstdint>
#include "kernel_operator.h"

namespace addrms {

using namespace AscendC;

constexpr uint32_t CHUNK_ELEMS = 2048;  // 每片处理的列数（fp32 下 8KB/片）
constexpr uint32_t SCALAR_ELEMS = 64;   // 标量/临时小缓冲（元素）

// host 侧 run_kernel 与 device 侧共用的一块 tiling 参数（直调模式）
struct AddRmsNormBiasTilingData {
    int32_t dtype;       // 0=fp32 1=fp16 2=bf16（与 TensorInfo.dtype 一致）
    uint32_t totalRows;  // 总 row 数 = 元素数 / D
    uint32_t D;          // 最后一维长度
    uint32_t blockRows;  // 每个 core 处理的 row 数
    float epsilon;
    float invD;          // 1.0f / D，host 算好避免 device 标量除法
};

struct TrueType {};
struct FalseType {};

// 元素级类型辅助：<T> 如何转 fp32 / 如何从 fp32 存回 T
template <typename T>
struct DtypeOps;

template <>
struct DtypeOps<half> {
    using IsFloat = FalseType;
    static __aicore__ inline LocalTensor<float> ToFp32(LocalTensor<half>& in,
                                                       LocalTensor<float>& out, uint32_t cnt)
    {
        Cast(out, in, RoundMode::CAST_NONE, cnt);
        PipeBarrier<PIPE_V>();
        return out;
    }
    static __aicore__ inline void Store(LocalTensor<half>& out, LocalTensor<float>& in, uint32_t cnt)
    {
        Cast(out, in, RoundMode::CAST_NONE, cnt);
        PipeBarrier<PIPE_V>();
    }
};

template <>
struct DtypeOps<bfloat16_t> {
    using IsFloat = FalseType;
    static __aicore__ inline LocalTensor<float> ToFp32(LocalTensor<bfloat16_t>& in,
                                                       LocalTensor<float>& out, uint32_t cnt)
    {
        Cast(out, in, RoundMode::CAST_NONE, cnt);
        PipeBarrier<PIPE_V>();
        return out;
    }
    static __aicore__ inline void Store(LocalTensor<bfloat16_t>& out, LocalTensor<float>& in, uint32_t cnt)
    {
        Cast(out, in, RoundMode::CAST_RINT, cnt);
        PipeBarrier<PIPE_V>();
    }
};

template <>
struct DtypeOps<float> {
    using IsFloat = TrueType;
    static __aicore__ inline LocalTensor<float> ToFp32(LocalTensor<float>& in,
                                                       LocalTensor<float>&, uint32_t)
    {
        return in;  // fp32 无需转换
    }
    static __aicore__ inline void Store(LocalTensor<float>&, const LocalTensor<float>&, uint32_t) {}
};

// 从 GM 把 tiling 参数拷到核内局部结构体（避免反复标量读 GM）
__aicore__ inline void CopyTilingLocal(AddRmsNormBiasTilingData* dst, GM_ADDR tilingGm)
{
    uint32_t* dstW = reinterpret_cast<uint32_t*>(dst);
    const __gm__ uint32_t* srcW = reinterpret_cast<const __gm__ uint32_t*>(tilingGm);
    for (uint32_t i = 0; i < sizeof(AddRmsNormBiasTilingData) / sizeof(uint32_t); i++) {
        dstW[i] = srcW[i];
    }
}

template <typename T>
class AddRmsNormBiasKernel {
public:
    __aicore__ inline AddRmsNormBiasKernel() {}

    __aicore__ inline void Init(GM_ADDR xGm, GM_ADDR rGm, GM_ADDR gGm, GM_ADDR bGm, GM_ADDR yGm,
                                const AddRmsNormBiasTilingData& tiling, TPipe* pipe)
    {
        pipe_ = pipe;
        D_ = tiling.D;
        epsilon_ = tiling.epsilon;
        invD_ = tiling.invD;

        uint32_t blockIdx = GetBlockIdx();
        uint32_t startRow = blockIdx * tiling.blockRows;
        uint32_t rowsLeft = (startRow < tiling.totalRows) ? (tiling.totalRows - startRow) : 0;
        rowCount_ = (rowsLeft < tiling.blockRows) ? rowsLeft : tiling.blockRows;
        elemStart_ = startRow * D_;
        totalElems_ = tiling.totalRows * D_;

        xG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(xGm), totalElems_);
        rG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(rGm), totalElems_);
        gG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gGm), D_);
        bG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bGm), D_);
        yG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(yGm), totalElems_);

        uint32_t dataBytes = CHUNK_ELEMS * sizeof(T);
        uint32_t fp32Bytes = CHUNK_ELEMS * sizeof(float);
        pipe_->InitBuffer(qX_, 1, dataBytes);
        pipe_->InitBuffer(qR_, 1, dataBytes);
        pipe_->InitBuffer(qG_, 1, dataBytes);
        pipe_->InitBuffer(qB_, 1, dataBytes);
        pipe_->InitBuffer(qOut_, 1, dataBytes);
        pipe_->InitBuffer(qW0_, 1, fp32Bytes);
        pipe_->InitBuffer(qW1_, 1, fp32Bytes);
        pipe_->InitBuffer(qW2_, 1, fp32Bytes);
        pipe_->InitBuffer(qS_, 1, SCALAR_ELEMS * sizeof(float));
        pipe_->InitBuffer(qT_, 1, SCALAR_ELEMS * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        // 逐行处理：每行先算自己的 rstd，再立刻用该行的 rstd 做归一化。
        // 不能拆成“先全部行求 rstd 再全部行归一化”，否则 rstd_ 会串行。
        for (uint32_t row = 0; row < rowCount_; row++) {
            uint32_t gmOff = elemStart_ + row * D_;
            RowSumOne(gmOff);  // 计算并保存本行 rstd_
            RowScaleOne(gmOff, typename DtypeOps<T>::IsFloat());
        }
    }

private:
    __aicore__ inline uint32_t PerBlockElems() const
    {
        return 32U / static_cast<uint32_t>(sizeof(T));
    }

    // GM -> UB：整 32B 块走 DataCopy；尾部不足一块时用 DataCopyPad（余量自动填 0）
    __aicore__ inline void CopyGmToUb(LocalTensor<T> dst, GlobalTensor<T> src, uint32_t cnt)
    {
        uint32_t per = PerBlockElems();
        uint32_t rem = cnt % per;
        if (rem == 0) {
            DataCopy(dst, src, cnt);
        } else {
            DataCopyExtParams cp{1, cnt * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
            DataCopyPadExtParams<T> pp;
            pp.isPad = true;
            pp.leftPadding = 0;
            pp.rightPadding = per - rem;
            DataCopyPad(dst, src, cp, pp);
        }
    }

    // UB -> GM：整块走 DataCopy；尾部不足一块时用 DataCopyPad 精确搬运
    __aicore__ inline void CopyUbToGm(GlobalTensor<T> dst, LocalTensor<T> src, uint32_t cnt)
    {
        uint32_t per = PerBlockElems();
        uint32_t rem = cnt % per;
        if (rem == 0) {
            DataCopy(dst, src, cnt);
        } else {
            DataCopyExtParams cp{1, cnt * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
            DataCopyPad(dst, src, cp);
        }
    }

    // ---------- 数据搬入（GM -> UB 队列） ----------
    __aicore__ inline LocalTensor<T> CopyInX(uint32_t gmOff, uint32_t cnt)
    {
        LocalTensor<T> l = qX_.AllocTensor<T>();
        CopyGmToUb(l, xG_[gmOff], cnt);
        qX_.EnQue(l);
        LocalTensor<T> d = qX_.DeQue<T>();
        PipeBarrier<PIPE_MTE2>();
        return d;
    }

    __aicore__ inline LocalTensor<T> CopyInR(uint32_t gmOff, uint32_t cnt)
    {
        LocalTensor<T> l = qR_.AllocTensor<T>();
        CopyGmToUb(l, rG_[gmOff], cnt);
        qR_.EnQue(l);
        LocalTensor<T> d = qR_.DeQue<T>();
        PipeBarrier<PIPE_MTE2>();
        return d;
    }

    __aicore__ inline LocalTensor<T> CopyInG(uint32_t off, uint32_t cnt)
    {
        LocalTensor<T> l = qG_.AllocTensor<T>();
        CopyGmToUb(l, gG_[off], cnt);
        qG_.EnQue(l);
        LocalTensor<T> d = qG_.DeQue<T>();
        PipeBarrier<PIPE_MTE2>();
        return d;
    }

    __aicore__ inline LocalTensor<T> CopyInB(uint32_t off, uint32_t cnt)
    {
        LocalTensor<T> l = qB_.AllocTensor<T>();
        CopyGmToUb(l, bG_[off], cnt);
        qB_.EnQue(l);
        LocalTensor<T> d = qB_.DeQue<T>();
        PipeBarrier<PIPE_MTE2>();
        return d;
    }

    // ---------- fp32 工作缓冲（把 VECIN 队列当固定缓冲池用） ----------
    __aicore__ inline LocalTensor<float> ScratchGet(TQue<TPosition::VECIN, 1>& q)
    {
        LocalTensor<float> l = q.AllocTensor<float>();
        q.EnQue(l);
        return q.DeQue<float>();
    }

    __aicore__ inline void ScratchPut(TQue<TPosition::VECIN, 1>& q, LocalTensor<float>& l)
    {
        q.FreeTensor(l);
    }

    // 把 buf[0..cnt) 原地归约为 buf[0]（纯 vector Add 二分树，带零填充）
    __aicore__ inline void TreeReduce(LocalTensor<float>& buf, uint32_t cnt)
    {
        uint32_t n = 1;
        while (n < cnt) {
            n <<= 1;
        }
        if (cnt < n) {
            Duplicate(buf[cnt], 0.0f, n - cnt);  // 树形归约要求容量为 2 的幂，尾部补零
            PipeBarrier<PIPE_V>();
        }
        while (n > 1) {
            Add(buf, buf, buf[n >> 1], n >> 1);
            PipeBarrier<PIPE_V>();
            n >>= 1;
        }
    }

    __aicore__ inline void SyncV2S()
    {
        event_t ev = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(ev);
        WaitFlag<HardEvent::V_S>(ev);
    }

    __aicore__ inline void SyncS2V()
    {
        event_t ev = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));
        SetFlag<HardEvent::S_V>(ev);
        WaitFlag<HardEvent::S_V>(ev);
    }

    __aicore__ inline void RowSumOne(uint32_t gmOff)
    {
        LocalTensor<float> acc = ScratchGet(qS_);
        Duplicate(acc, 0.0f, 1);
        PipeBarrier<PIPE_V>();

        uint32_t remain = D_;
        uint32_t colOff = 0;
        while (remain > 0) {
            uint32_t cnt = (remain > CHUNK_ELEMS) ? CHUNK_ELEMS : remain;

            LocalTensor<T> xL = CopyInX(gmOff + colOff, cnt);
            LocalTensor<T> rL = CopyInR(gmOff + colOff, cnt);

            LocalTensor<float> wA = ScratchGet(qW0_);
            LocalTensor<float> wB = ScratchGet(qW1_);
            LocalTensor<float> wC = ScratchGet(qW2_);

            LocalTensor<float> xF = DtypeOps<T>::ToFp32(xL, wA, cnt);   // half->fp32（fp32 直接别名）
            LocalTensor<float> rF = DtypeOps<T>::ToFp32(rL, wB, cnt);
            Add(wC, xF, rF, cnt);       // y = x + residual
            PipeBarrier<PIPE_V>();
            Mul(wB, wC, wC, cnt);       // y^2（rF 已用完，复用 wB）
            PipeBarrier<PIPE_V>();
            TreeReduce(wB, cnt);        // 该片 sum(y^2) -> wB[0]
            Add(acc, acc, wB, 1);       // 累加各片 partial sum
            PipeBarrier<PIPE_V>();

            ScratchPut(qW0_, wA);
            ScratchPut(qW1_, wB);
            ScratchPut(qW2_, wC);
            qX_.FreeTensor(xL);
            qR_.FreeTensor(rL);

            remain -= cnt;
            colOff += cnt;
        }

        // rstd = 1 / sqrt(mean(y^2) + eps)
        Muls(acc, acc, invD_, 1);
        PipeBarrier<PIPE_V>();
        Adds(acc, acc, epsilon_, 1);
        PipeBarrier<PIPE_V>();
        Sqrt(acc, acc, 1);
        PipeBarrier<PIPE_V>();

        LocalTensor<float> one = ScratchGet(qT_);
        Duplicate(one, 1.0f, 1);
        PipeBarrier<PIPE_V>();
        Div(acc, one, acc, 1);          // 1 / rms
        PipeBarrier<PIPE_V>();

        SyncV2S();
        rstd_ = acc.GetValue(0);
        SyncS2V();

        ScratchPut(qS_, acc);
        ScratchPut(qT_, one);
    }

    // ---------- 第二遍：y = (x+residual); out = y*rstd*gamma + bias ----------
    __aicore__ inline void RowScaleOne(uint32_t gmOff, FalseType)
    {
        uint32_t remain = D_;
        uint32_t colOff = 0;
        while (remain > 0) {
            uint32_t cnt = (remain > CHUNK_ELEMS) ? CHUNK_ELEMS : remain;

            LocalTensor<T> xL = CopyInX(gmOff + colOff, cnt);
            LocalTensor<T> rL = CopyInR(gmOff + colOff, cnt);
            LocalTensor<T> gL = CopyInG(colOff, cnt);
            LocalTensor<T> bL = CopyInB(colOff, cnt);

            LocalTensor<float> wA = ScratchGet(qW0_);
            LocalTensor<float> wB = ScratchGet(qW1_);
            LocalTensor<float> wC = ScratchGet(qW2_);

            LocalTensor<float> xF = DtypeOps<T>::ToFp32(xL, wA, cnt);
            LocalTensor<float> rF = DtypeOps<T>::ToFp32(rL, wB, cnt);
            Add(wC, xF, rF, cnt);            // y
            PipeBarrier<PIPE_V>();
            Muls(wC, wC, rstd_, cnt);        // y / rms
            PipeBarrier<PIPE_V>();
            LocalTensor<float> gF = DtypeOps<T>::ToFp32(gL, wA, cnt);  // 复用 wA
            Mul(wC, wC, gF, cnt);            // * gamma
            PipeBarrier<PIPE_V>();
            LocalTensor<float> bF = DtypeOps<T>::ToFp32(bL, wB, cnt);  // 复用 wB
            Add(wC, wC, bF, cnt);            // + bias
            PipeBarrier<PIPE_V>();

            LocalTensor<T> outL = qOut_.AllocTensor<T>();
            DtypeOps<T>::Store(outL, wC, cnt);
            qOut_.EnQue(outL);
            LocalTensor<T> outD = qOut_.DeQue<T>();
            CopyUbToGm(yG_[gmOff + colOff], outD, cnt);
            qOut_.FreeTensor(outD);

            ScratchPut(qW0_, wA);
            ScratchPut(qW1_, wB);
            ScratchPut(qW2_, wC);
            qX_.FreeTensor(xL);
            qR_.FreeTensor(rL);
            qG_.FreeTensor(gL);
            qB_.FreeTensor(bL);

            remain -= cnt;
            colOff += cnt;
        }
    }

    // fp32 特化：全程 fp32，无需 cast，直接算到 out 队列缓冲
    __aicore__ inline void RowScaleOne(uint32_t gmOff, TrueType)
    {
        uint32_t remain = D_;
        uint32_t colOff = 0;
        while (remain > 0) {
            uint32_t cnt = (remain > CHUNK_ELEMS) ? CHUNK_ELEMS : remain;

            LocalTensor<float> xL = CopyInX(gmOff + colOff, cnt);
            LocalTensor<float> rL = CopyInR(gmOff + colOff, cnt);
            LocalTensor<float> gL = CopyInG(colOff, cnt);
            LocalTensor<float> bL = CopyInB(colOff, cnt);

            LocalTensor<float> outL = qOut_.AllocTensor<float>();
            Add(outL, xL, rL, cnt);
            PipeBarrier<PIPE_V>();
            Muls(outL, outL, rstd_, cnt);
            PipeBarrier<PIPE_V>();
            Mul(outL, outL, gL, cnt);
            PipeBarrier<PIPE_V>();
            Add(outL, outL, bL, cnt);
            PipeBarrier<PIPE_V>();

            qOut_.EnQue(outL);
            LocalTensor<float> outD = qOut_.DeQue<float>();
            CopyUbToGm(yG_[gmOff + colOff], outD, cnt);
            qOut_.FreeTensor(outD);

            qX_.FreeTensor(xL);
            qR_.FreeTensor(rL);
            qG_.FreeTensor(gL);
            qB_.FreeTensor(bL);

            remain -= cnt;
            colOff += cnt;
        }
    }

private:
    TPipe* pipe_ = nullptr;
    uint32_t rowCount_ = 0;
    uint32_t elemStart_ = 0;
    uint32_t totalElems_ = 0;
    uint32_t D_ = 0;
    float epsilon_ = 1e-5f;
    float invD_ = 0.0f;
    float rstd_ = 0.0f;

    GlobalTensor<T> xG_;
    GlobalTensor<T> rG_;
    GlobalTensor<T> gG_;
    GlobalTensor<T> bG_;
    GlobalTensor<T> yG_;

    TQue<TPosition::VECIN, 1> qX_;
    TQue<TPosition::VECIN, 1> qR_;
    TQue<TPosition::VECIN, 1> qG_;
    TQue<TPosition::VECIN, 1> qB_;
    TQue<TPosition::VECOUT, 1> qOut_;
    // fp32 工作缓冲（同样放在 UB，仅作缓冲池，不经数据搬移）
    TQue<TPosition::VECIN, 1> qW0_;
    TQue<TPosition::VECIN, 1> qW1_;
    TQue<TPosition::VECIN, 1> qW2_;
    TQue<TPosition::VECIN, 1> qS_;
    TQue<TPosition::VECIN, 1> qT_;
};

}  // namespace addrms

// ============================================================================
// device 核函数入口：按 tiling.dtype 分派到 fp16 / bf16 / fp32 模板实例
// ============================================================================
extern "C" __global__ __vector__ void add_rms_norm_bias_custom(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
                                                               GM_ADDR bias, GM_ADDR output, GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;
    addrms::AddRmsNormBiasTilingData tiling;
    addrms::CopyTilingLocal(&tiling, tilingGm);

    if (tiling.dtype == 1) {
        addrms::AddRmsNormBiasKernel<half> op;
        op.Init(x, residual, gamma, bias, output, tiling, &pipe);
        op.Process();
    } else if (tiling.dtype == 2) {
        addrms::AddRmsNormBiasKernel<bfloat16_t> op;
        op.Init(x, residual, gamma, bias, output, tiling, &pipe);
        op.Process();
    } else {
        addrms::AddRmsNormBiasKernel<float> op;
        op.Init(x, residual, gamma, bias, output, tiling, &pipe);
        op.Process();
    }
}

// ============================================================================
// host 侧启动函数：读取形状信息 -> 计算 blockNum/tiling -> 直调核函数
// ============================================================================
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR residual,
                           const TensorGroupInfo& info_residual, GM_ADDR gamma, const TensorGroupInfo& info_gamma,
                           GM_ADDR bias, const TensorGroupInfo& info_bias, GM_ADDR output,
                           const TensorGroupInfo& info_output, int64_t availableCoreNum, aclrtStream stream,
                           float epsilon)
{
    const int64_t* shape = info_x.tensors[0].shape;
    int64_t numDims = info_x.tensors[0].numDims;
    int32_t dtype = info_x.tensors[0].dtype;

    if (numDims < 2) {
        // 输入必须至少 2D（最后一位是 D），否则直接返回
        return;
    }
    int64_t D = shape[numDims - 1];
    if (D <= 0) {
        // D 非法，直接返回
        return;
    }
    if (dtype != 0 && dtype != 1 && dtype != 2) {
        // 仅支持 fp32/fp16/bf16
        return;
    }

    int64_t totalElems = 1;
    for (int64_t i = 0; i < numDims; i++) {
        totalElems *= shape[i];
    }
    int64_t totalRows = totalElems / D;

    int64_t blockNum = (totalRows < availableCoreNum) ? totalRows : availableCoreNum;
    if (blockNum < 1) {
        blockNum = 1;
    }
    uint32_t blockRows = static_cast<uint32_t>((totalRows + blockNum - 1) / blockNum);

    addrms::AddRmsNormBiasTilingData tiling;
    tiling.dtype = dtype;
    tiling.totalRows = static_cast<uint32_t>(totalRows);
    tiling.D = static_cast<uint32_t>(D);
    tiling.blockRows = blockRows;
    tiling.epsilon = epsilon;
    tiling.invD = 1.0f / static_cast<float>(D);

    void* tilingDev = nullptr;
    if (aclrtMalloc(&tilingDev, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
        // tiling 内存申请失败
        return;
    }
    if (aclrtMemcpy(tilingDev, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE) != 0) {
        aclrtFree(tilingDev);
        return;
    }

    add_rms_norm_bias_custom<<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(x, residual, gamma, bias, output,
                                                                                  (GM_ADDR)tilingDev);

    aclrtSynchronizeStream(stream);  // tiling 缓冲用完即释放
    aclrtFree(tilingDev);
}
