// ============================================================================
// kernel.asc — AddRmsNormBias（Ascend C 直调，TBuf-only，无 TQue）
//
//   y    = x + residual
//   rms  = sqrt(mean(y^2) + epsilon)
//   out  = y / rms * gamma + bias
//
// 按行分派的四条内核路径（见 AddRmsNormBiasTilingPrepare 的 group 分派）：
//   1) AddRmsNormBiasKernel（group0 保底）：逐行 RowSum/RowScale，chunk 大块
//      搬运 + fp32 树形归约 + keepY。仅覆盖三条高速路径没接住的形状。
//   2) AddRmsNormBiasGroup（group1）：对齐行（fp16/bf16 D%16==0、fp32 D%8==0）
//      且 64<=D<=32768。整 tile 搬运 + 整 tile 宽向量；D<=2048 时 γ/β 整行常驻
//      UB，D>2048（宽行）按窗口两次读 x/residual（UltraRow 双缓冲），γ/β 按
//      PARAM_STRIPE 流式分块；D<=384 的 fp16/bf16 走整 tile 批量 pass2。
//   3) AddRmsNormBiasPad（group2）：非对齐行 64<=D<=2048。行在 UB 内按
//      rowPad=align64(D) 填零对齐存放，向量/归约全程在 padding 空间进行，
//      GM 侧逐行 DataCopyPad 精确读写。
//   4) AddRmsNormBiasPadWide（group3）：非对齐宽行 2048<D<=32768。逐行窗口
//      化两遍处理（同 UltraRow），GM 逐窗口 DataCopyPad 精确读/写、补零到
//      向量粒度，γ/β 分块流式，仅行尾子块做越界保护。
//
// 正确性策略：所有跨引擎(MTE2/MTE3 与 V)的 buffer 复用以 PipeBarrier<PIPE_ALL>
// 或 V_S/S_V 事件同步保护；同 pipe 内依赖运算保留 PIPE_V 屏障。
// ============================================================================

#include <cstdint>
#include "kernel_operator.h"

namespace addrms {

using namespace AscendC;

constexpr uint32_t CHUNK_ELEMS = 2048;  // 一次搬运/计算的最大元素数
constexpr uint32_t ACC_LANES = 64;      // 每行 fp32 部分和 lane 数（向量归约到 8 lane）
constexpr uint32_t TAIL_LANES = 8;      // 向量归约最终保留的 lane 数
constexpr uint32_t GB_CACHE_BYTES = 64 * 1024;  // gamma+bias 常驻 UB 的字节上限

struct AddRmsNormBiasTilingData {
    int32_t dtype;        // 0=fp32 1=fp16 2=bf16
    uint32_t totalRows;
    uint32_t D;
    uint32_t blockRows;
    float epsilon;
    float invD;
    uint32_t group;       // 0 = 保底逐行；1 = 对齐行批量；2 = 非对齐行 padded(D<=2048)；3 = 非对齐宽行 padded
};

struct TrueType {};
struct FalseType {};

// ---- 元素级类型辅助 ----
template <typename T>
struct DtypeOps;

template <>
struct DtypeOps<half> {
    using IsFloat = FalseType;
    static __aicore__ inline uint32_t Per32() { return 16U; }
    static __aicore__ inline LocalTensor<float> ToFp32(LocalTensor<half>& in,
                                                       LocalTensor<float>& out, uint32_t cnt) {
        Cast(out, in, RoundMode::CAST_NONE, cnt);
        PipeBarrier<PIPE_V>();
        return out;
    }
    static __aicore__ inline void Store(LocalTensor<half>& out, LocalTensor<float>& in, uint32_t cnt) {
        Cast(out, in, RoundMode::CAST_RINT, cnt);  // round-to-nearest-even
        PipeBarrier<PIPE_V>();
    }
};

template <>
struct DtypeOps<bfloat16_t> {
    using IsFloat = FalseType;
    static __aicore__ inline uint32_t Per32() { return 16U; }
    static __aicore__ inline LocalTensor<float> ToFp32(LocalTensor<bfloat16_t>& in,
                                                       LocalTensor<float>& out, uint32_t cnt) {
        Cast(out, in, RoundMode::CAST_NONE, cnt);
        PipeBarrier<PIPE_V>();
        return out;
    }
    static __aicore__ inline void Store(LocalTensor<bfloat16_t>& out, LocalTensor<float>& in, uint32_t cnt) {
        Cast(out, in, RoundMode::CAST_RINT, cnt);
        PipeBarrier<PIPE_V>();
    }
};

template <>
struct DtypeOps<float> {
    using IsFloat = TrueType;
    static __aicore__ inline uint32_t Per32() { return 8U; }
    static __aicore__ inline LocalTensor<float> ToFp32(LocalTensor<float>& in,
                                                       LocalTensor<float>&, uint32_t) { return in; }
    static __aicore__ inline void Store(LocalTensor<float>&, const LocalTensor<float>&, uint32_t) {}
};

__aicore__ inline void CopyTilingLocal(AddRmsNormBiasTilingData* dst, GM_ADDR tilingGm) {
    uint32_t* dstW = reinterpret_cast<uint32_t*>(dst);
    const __gm__ uint32_t* srcW = reinterpret_cast<const __gm__ uint32_t*>(tilingGm);
    for (uint32_t i = 0; i < sizeof(AddRmsNormBiasTilingData) / sizeof(uint32_t); i++) {
        dstW[i] = srcW[i];
    }
}

// 大于等于 x 且满足 32B 对齐的字节数
static __aicore__ inline uint32_t RoundUp32(uint32_t bytes) {
    return (bytes + 31U) & ~31U;
}

template <typename T>
class AddRmsNormBiasKernel {
public:
    __aicore__ inline void Init(GM_ADDR xGm, GM_ADDR rGm, GM_ADDR gGm, GM_ADDR bGm, GM_ADDR yGm,
                                const AddRmsNormBiasTilingData& tiling, TPipe* pipe) {
        pipe_ = pipe;
        D_ = tiling.D;
        epsilon_ = tiling.epsilon;
        invD_ = tiling.invD;
        per32_ = DtypeOps<T>::Per32();
        rowAligned_ = (D_ % per32_ == 0);

        uint32_t blockIdx = GetBlockIdx();
        uint32_t startRow = blockIdx * tiling.blockRows;
        uint32_t rowsLeft = (startRow < tiling.totalRows) ? (tiling.totalRows - startRow) : 0;
        rowCount_ = (rowsLeft < tiling.blockRows) ? rowsLeft : tiling.blockRows;
        elemStart_ = startRow * D_;
        totalElems_ = tiling.totalRows * D_;

        xG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(xGm), totalElems_);
        rG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(rGm), totalElems_);
        gG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gGm), D_);
        bG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bGm), D_);
        yG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(yGm), totalElems_);
        outGm_ = yGm;

        keepY_ = (D_ <= CHUNK_ELEMS);   // 单块行：pass1 把 y=x+r 留在 UB，pass2 免二次读 x/r
        uint32_t tBytes = CHUNK_ELEMS * sizeof(T);
        uint32_t fBytes = CHUNK_ELEMS * sizeof(float);
        uint32_t treeBytes = (CHUNK_ELEMS / 2) * sizeof(float);  // 二叉树归约的辅助缓冲
        pipe_->InitBuffer(bufX_, tBytes);
        pipe_->InitBuffer(bufR_, tBytes);
        pipe_->InitBuffer(bufG_, tBytes);
        pipe_->InitBuffer(bufB_, tBytes);
        pipe_->InitBuffer(bufOut_, tBytes);
        pipe_->InitBuffer(bufW0_, fBytes);
        pipe_->InitBuffer(bufW1_, fBytes);
        pipe_->InitBuffer(bufW2_, fBytes);
        pipe_->InitBuffer(bufWS_, treeBytes);
        pipe_->InitBuffer(bufAcc_, sizeof(float) * ACC_LANES);
        pipe_->InitBuffer(bufTmp_, sizeof(float) * TAIL_LANES);
        if (keepY_) {
            pipe_->InitBuffer(bufY_, D_ * sizeof(float));
            yRow_ = bufY_.Get<float>();
        }

        xL_ = bufX_.Get<T>();
        rL_ = bufR_.Get<T>();
        gL_ = bufG_.Get<T>();
        bL_ = bufB_.Get<T>();
        outL_ = bufOut_.Get<T>();
        wA_ = bufW0_.Get<float>();
        wB_ = bufW1_.Get<float>();
        wC_ = bufW2_.Get<float>();
        wS_ = bufWS_.Get<float>();
        acc_ = bufAcc_.Get<float>();
        tmp_ = bufTmp_.Get<float>();

        // gamma/bias 常驻 UB：仅在两者之和不超过 64KB 时启用
        uint32_t paramBytes = 2U * D_ * static_cast<uint32_t>(sizeof(T));
        cacheGB_ = (paramBytes <= GB_CACHE_BYTES);
        if (cacheGB_) {
            uint32_t gBytes = RoundUp32(D_ * static_cast<uint32_t>(sizeof(T)));
            pipe_->InitBuffer(bufGC_, gBytes);
            pipe_->InitBuffer(bufBC_, gBytes);
            gCache_ = bufGC_.Get<T>();
            bCache_ = bufBC_.Get<T>();
        }
    }

    __aicore__ inline void Process() {
        if (cacheGB_) {
            LoadParamBuf(gCache_, gG_, D_);
            LoadParamBuf(bCache_, bG_, D_);
        }
        for (uint32_t row = 0; row < rowCount_; row++) {
            uint32_t rowOff = elemStart_ + row * D_;
            RowSumOne(rowOff);
            RowScaleOne(rowOff, typename DtypeOps<T>::IsFloat());
        }
    }

private:
    // GM(可能带元素偏移) -> UB（chunk 缓冲，容量 CHUNK_ELEMS）。
    __aicore__ inline void LoadTile(LocalTensor<T> dst, GlobalTensor<T>& g, uint32_t gOff,
                                    uint32_t cnt) {
        uint32_t byteOff = (gOff % per32_) * static_cast<uint32_t>(sizeof(T));
        bool needPad = !rowAligned_ || (byteOff != 0) ||
                       ((cnt * static_cast<uint32_t>(sizeof(T))) % 32U != 0);
        PipeBarrier<PIPE_ALL>();   // 之前的 vector/MTE3 使用本 buffer 必须全部结束
        if (!needPad) {
            DataCopy(dst, g[gOff], cnt);
            PipeBarrier<PIPE_ALL>();   // MTE2 写完后再让 vector 读 dst
            return;
        }
        // 先整体清 0，再精确拷有效字节；不足 32B 的尾部用 DataCopyPad 截断到
        // 下一个 32B 边界（该块读出的越界字节不会写回 dst 的有效/零区）。
        Duplicate(dst, T(0), CHUNK_ELEMS);
        PipeBarrier<PIPE_ALL>();   // vector 清零完成后再让 MTE2 覆盖有效区
        DataCopyExtParams cp;
        cp.blockCount = 1;
        cp.blockLen = cnt * static_cast<uint32_t>(sizeof(T));
        cp.srcStride = 0;
        cp.dstStride = 0;
        cp.rsv = 0;
        DataCopyPadExtParams<T> pp;
        pp.isPad = false;
        pp.leftPadding = 0;
        pp.rightPadding = 0;
        pp.paddingValue = T(0);
        DataCopyPad(dst, g[gOff], cp, pp);
        PipeBarrier<PIPE_ALL>();   // 本 slice 的 MTE2 写完，后续可安全复用 dst
    }

    // GM(偏移0) -> UB（参数缓冲，容量 elems）。
    __aicore__ inline void LoadParamBuf(LocalTensor<T> dst, GlobalTensor<T>& g, uint32_t elems) {
        bool needPad = !rowAligned_ || ((elems * static_cast<uint32_t>(sizeof(T))) % 32U != 0);
        PipeBarrier<PIPE_ALL>();
        if (!needPad) {
            DataCopy(dst, g[0], elems);
            PipeBarrier<PIPE_ALL>();
            return;
        }
        // 清零个数向上对齐到 per32_（vector 运算按 32B 粒度执行）
        uint32_t clearCnt = ((elems + per32_ - 1) / per32_) * per32_;
        Duplicate(dst, T(0), clearCnt);
        PipeBarrier<PIPE_ALL>();
        DataCopyExtParams cp;
        cp.blockCount = 1;
        cp.blockLen = elems * static_cast<uint32_t>(sizeof(T));
        cp.srcStride = 0;
        cp.dstStride = 0;
        cp.rsv = 0;
        DataCopyPadExtParams<T> pp;
        pp.isPad = false;
        pp.leftPadding = 0;
        pp.rightPadding = 0;
        pp.paddingValue = T(0);
        DataCopyPad(dst, g[0], cp, pp);
        PipeBarrier<PIPE_ALL>();
    }

    // UB -> GM，只写 cnt 个有效元素（chunk 缓冲）。
    __aicore__ inline void StoreTile(GlobalTensor<T>& g, uint32_t gOff, LocalTensor<T> src,
                                     uint32_t cnt) {
        uint32_t byteOff = (gOff % per32_) * static_cast<uint32_t>(sizeof(T));
        bool needPad = !rowAligned_ || (byteOff != 0) ||
                       ((cnt * static_cast<uint32_t>(sizeof(T))) % 32U != 0);
        PipeBarrier<PIPE_ALL>();   // vector 写 src 完成后再发起 MTE3 读
        if (!needPad) {
            DataCopy(g[gOff], src, cnt);
            PipeBarrier<PIPE_ALL>();   // MTE3 读完 src 前不得复用
            return;
        }
        DataCopyExtParams cp;
        cp.blockCount = 1;
        cp.blockLen = cnt * static_cast<uint32_t>(sizeof(T));
        cp.srcStride = 0;
        cp.dstStride = 0;
        cp.rsv = 0;
        DataCopyPad(g[gOff], src, cp);
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void SyncV2S() {
        event_t ev = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(ev);
        WaitFlag<HardEvent::V_S>(ev);
    }

    __aicore__ inline void SyncS2V() {
        event_t ev = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));
        SetFlag<HardEvent::S_V>(ev);
        WaitFlag<HardEvent::S_V>(ev);
    }

    // 将 fp32 累加器(64 lane)向量归约到 8 lane。
    __aicore__ inline void ReduceAccTo8() {
        Add(acc_, acc_, acc_[ACC_LANES / 2], ACC_LANES / 2);
        PipeBarrier<PIPE_V>();
        Add(acc_, acc_, acc_[ACC_LANES / 4], ACC_LANES / 4);
        PipeBarrier<PIPE_V>();
        Add(acc_, acc_, acc_[ACC_LANES / 8], ACC_LANES / 8);
        PipeBarrier<PIPE_V>();
    }

    // 二叉树归约：把 src[0, pow2Part) 两两相加降到 64 lane，累加进 acc_。
    // pow2Part 必须是 >=64 的 2 的幂。树形写回只占用 src 的低位区，
    // 不会破坏 src[pow2Part..)（尾部窗口累加仍可用）。
    __aicore__ inline void TreeReduce64(LocalTensor<float> src, uint32_t pow2Part) {
        uint32_t len = pow2Part;
        LocalTensor<float> cur = src;
        bool inSrc = true;
        while (len > ACC_LANES) {
            uint32_t half = len >> 1;
            if (inSrc) {
                Add(wS_, cur, cur[half], half);   // 读出 cur[0,half)+cur[half,len)
                PipeBarrier<PIPE_V>();
                cur = wS_;
            } else {
                Add(wA_, cur, cur[half], half);
                PipeBarrier<PIPE_V>();
                cur = wA_;
            }
            inSrc = !inSrc;
            len = half;
        }
        Add(acc_, acc_, cur, ACC_LANES);
        PipeBarrier<PIPE_V>();
    }

    // 把一块平方和(长度 cnt)累加进 acc_（64 lane 部分和）。
    __aicore__ inline void AccumulateBlock(LocalTensor<float> src, uint32_t cnt) {
        // 取不超过 cnt 的最大 2 的幂（且 >=64）
        uint32_t p = 1U;
        while ((p << 1) <= cnt) {
            p <<= 1;
        }
        if (p >= ACC_LANES) {
            TreeReduce64(src, p);
        }
        // 尾部（不足 64 lane 或非 2 的幂余量）逐窗口累加
        uint32_t off = p;
        while (off < cnt) {
            uint32_t w = cnt - off;
            if (w > ACC_LANES) {
                w = ACC_LANES;
            }
            Add(acc_, acc_, src[off], w);
            PipeBarrier<PIPE_V>();
            off += w;
        }
    }

    // ============ Pass1：y=x+residual；acc = sum(y^2)；rstd = 1/sqrt(sum/D+eps) ============
    __aicore__ inline void RowSumOne(uint32_t rowOff) {
        Duplicate(acc_, 0.0f, ACC_LANES);
        PipeBarrier<PIPE_V>();

        uint32_t remain = D_;
        uint32_t colOff = 0;
        bool fast = rowAligned_;   // 行内 32B 对齐时可把多个 DataCopy 合并发出
        while (remain > 0) {
            uint32_t cnt = (remain > CHUNK_ELEMS) ? CHUNK_ELEMS : remain;
            uint32_t absOff = rowOff + colOff;

            if (fast) {
                PipeBarrier<PIPE_ALL>();   // 本块 vector/MTE3 对 xL_/rL_ 的访问结束
                DataCopy(xL_, xG_[absOff], cnt);
                DataCopy(rL_, rG_[absOff], cnt);
                PipeBarrier<PIPE_ALL>();   // 两路 MTE2 写完
            } else {
                LoadTile(xL_, xG_, absOff, cnt);
                LoadTile(rL_, rG_, absOff, cnt);
            }

            LocalTensor<float> xF = DtypeOps<T>::ToFp32(xL_, wA_, cnt);
            LocalTensor<float> rF = DtypeOps<T>::ToFp32(rL_, wB_, cnt);
            Add(wC_, xF, rF, cnt);          // y
            PipeBarrier<PIPE_V>();
            Mul(wA_, wC_, wC_, cnt);        // y^2
            PipeBarrier<PIPE_V>();
            if (keepY_) {
                Adds(yRow_, wC_, 0.0f, cnt);   // y 留在 UB（仅单块行，colOff==0）
                PipeBarrier<PIPE_V>();
            }

            AccumulateBlock(wA_, cnt);

            remain -= cnt;
            colOff += cnt;
        }

        // 64 lane -> 8 lane
        ReduceAccTo8();
        // 8 lane 用标量求和，得到整行 sum(y^2)
        SyncV2S();
        float total = 0.0f;
        for (uint32_t i = 0; i < TAIL_LANES; i++) {
            total += acc_.GetValue(i);
        }
        SyncS2V();

        // rstd 的向量计算（8 lane 始终 >= 32B）
        Duplicate(tmp_, total, TAIL_LANES);
        PipeBarrier<PIPE_V>();
        Muls(tmp_, tmp_, invD_, TAIL_LANES);
        PipeBarrier<PIPE_V>();
        Adds(tmp_, tmp_, epsilon_, TAIL_LANES);
        PipeBarrier<PIPE_V>();
        Sqrt(tmp_, tmp_, TAIL_LANES);
        PipeBarrier<PIPE_V>();
        Duplicate(wC_, 1.0f, TAIL_LANES);
        PipeBarrier<PIPE_V>();
        Div(tmp_, wC_, tmp_, TAIL_LANES);
        PipeBarrier<PIPE_V>();

        SyncV2S();
        rstd_ = tmp_.GetValue(0);
        SyncS2V();
    }

    // ============ Pass2：out = ((x+residual)*rstd*gamma) + bias ============
    // half / bf16 特化：升 fp32 计算，输出一次 round 回原类型
    __aicore__ inline void RowScaleOne(uint32_t rowOff, FalseType) {
        uint32_t remain = D_;
        uint32_t colOff = 0;
        bool fast = rowAligned_;
        while (remain > 0) {
            uint32_t cnt = (remain > CHUNK_ELEMS) ? CHUNK_ELEMS : remain;
            uint32_t absOff = rowOff + colOff;

            if (keepY_) {
                // y 已在 UB（pass1 写入），免去二次读取 x/residual
                Muls(wC_, yRow_, rstd_, cnt);
                PipeBarrier<PIPE_V>();
                LocalTensor<float> gF;
                if (cacheGB_) {
                    Cast(wA_, gCache_[colOff], RoundMode::CAST_NONE, cnt);
                    PipeBarrier<PIPE_V>();
                    gF = wA_;
                } else {
                    LoadTile(gL_, gG_, colOff, cnt);
                    gF = DtypeOps<T>::ToFp32(gL_, wA_, cnt);
                }
                Mul(wC_, wC_, gF, cnt);
                PipeBarrier<PIPE_V>();
                LocalTensor<float> bF;
                if (cacheGB_) {
                    Cast(wB_, bCache_[colOff], RoundMode::CAST_NONE, cnt);
                    PipeBarrier<PIPE_V>();
                    bF = wB_;
                } else {
                    LoadTile(bL_, bG_, colOff, cnt);
                    bF = DtypeOps<T>::ToFp32(bL_, wB_, cnt);
                }
                Add(wC_, wC_, bF, cnt);
                PipeBarrier<PIPE_V>();
                DtypeOps<T>::Store(outL_, wC_, cnt);
                StoreTile(yG_, absOff, outL_, cnt);
                remain -= cnt;
                colOff += cnt;
                continue;
            }

            if (fast && cacheGB_) {
                PipeBarrier<PIPE_ALL>();
                DataCopy(xL_, xG_[absOff], cnt);
                DataCopy(rL_, rG_[absOff], cnt);
                PipeBarrier<PIPE_ALL>();
            } else if (fast) {
                PipeBarrier<PIPE_ALL>();
                DataCopy(xL_, xG_[absOff], cnt);
                DataCopy(rL_, rG_[absOff], cnt);
                DataCopy(gL_, gG_[colOff], cnt);
                DataCopy(bL_, bG_[colOff], cnt);
                PipeBarrier<PIPE_ALL>();
            } else {
                LoadTile(xL_, xG_, absOff, cnt);
                LoadTile(rL_, rG_, absOff, cnt);
                if (!cacheGB_) {
                    LoadTile(gL_, gG_, colOff, cnt);
                    LoadTile(bL_, bG_, colOff, cnt);
                }
            }

            LocalTensor<float> xF = DtypeOps<T>::ToFp32(xL_, wA_, cnt);
            LocalTensor<float> rF = DtypeOps<T>::ToFp32(rL_, wB_, cnt);
            Add(wC_, xF, rF, cnt);
            PipeBarrier<PIPE_V>();
            Muls(wC_, wC_, rstd_, cnt);
            PipeBarrier<PIPE_V>();

            LocalTensor<float> gF;
            if (cacheGB_) {
                Cast(wA_, gCache_[colOff], RoundMode::CAST_NONE, cnt);  // 复用 wA_（xF 已消费）
                PipeBarrier<PIPE_V>();
                gF = wA_;
            } else {
                gF = DtypeOps<T>::ToFp32(gL_, wA_, cnt);
            }
            Mul(wC_, wC_, gF, cnt);
            PipeBarrier<PIPE_V>();

            LocalTensor<float> bF;
            if (cacheGB_) {
                Cast(wB_, bCache_[colOff], RoundMode::CAST_NONE, cnt);  // 复用 wB_（rF 已消费）
                PipeBarrier<PIPE_V>();
                bF = wB_;
            } else {
                bF = DtypeOps<T>::ToFp32(bL_, wB_, cnt);
            }
            Add(wC_, wC_, bF, cnt);
            PipeBarrier<PIPE_V>();

            DtypeOps<T>::Store(outL_, wC_, cnt);
            StoreTile(yG_, absOff, outL_, cnt);

            remain -= cnt;
            colOff += cnt;
        }
    }

    // fp32 特化：全程 fp32，直接在输出 buffer 上算
    __aicore__ inline void RowScaleOne(uint32_t rowOff, TrueType) {
        uint32_t remain = D_;
        uint32_t colOff = 0;
        bool fast = rowAligned_;
        while (remain > 0) {
            uint32_t cnt = (remain > CHUNK_ELEMS) ? CHUNK_ELEMS : remain;
            uint32_t absOff = rowOff + colOff;

            if (keepY_) {
                Muls(outL_, yRow_, rstd_, cnt);
                PipeBarrier<PIPE_V>();
                if (cacheGB_) {
                    Mul(outL_, outL_, gCache_[colOff], cnt);
                    PipeBarrier<PIPE_V>();
                    Add(outL_, outL_, bCache_[colOff], cnt);
                    PipeBarrier<PIPE_V>();
                } else {
                    LoadTile(gL_, gG_, colOff, cnt);
                    LoadTile(bL_, bG_, colOff, cnt);
                    Mul(outL_, outL_, gL_, cnt);
                    PipeBarrier<PIPE_V>();
                    Add(outL_, outL_, bL_, cnt);
                    PipeBarrier<PIPE_V>();
                }
                StoreTile(yG_, absOff, outL_, cnt);
                remain -= cnt;
                colOff += cnt;
                continue;
            }

            if (fast && cacheGB_) {
                PipeBarrier<PIPE_ALL>();
                DataCopy(xL_, xG_[absOff], cnt);
                DataCopy(rL_, rG_[absOff], cnt);
                PipeBarrier<PIPE_ALL>();
            } else if (fast) {
                PipeBarrier<PIPE_ALL>();
                DataCopy(xL_, xG_[absOff], cnt);
                DataCopy(rL_, rG_[absOff], cnt);
                DataCopy(gL_, gG_[colOff], cnt);
                DataCopy(bL_, bG_[colOff], cnt);
                PipeBarrier<PIPE_ALL>();
            } else {
                LoadTile(xL_, xG_, absOff, cnt);
                LoadTile(rL_, rG_, absOff, cnt);
                if (!cacheGB_) {
                    LoadTile(gL_, gG_, colOff, cnt);
                    LoadTile(bL_, bG_, colOff, cnt);
                }
            }

            Add(outL_, xL_, rL_, cnt);
            PipeBarrier<PIPE_V>();
            Muls(outL_, outL_, rstd_, cnt);
            PipeBarrier<PIPE_V>();

            if (cacheGB_) {
                Mul(outL_, outL_, gCache_[colOff], cnt);
                PipeBarrier<PIPE_V>();
                Add(outL_, outL_, bCache_[colOff], cnt);
                PipeBarrier<PIPE_V>();
            } else {
                Mul(outL_, outL_, gL_, cnt);
                PipeBarrier<PIPE_V>();
                Add(outL_, outL_, bL_, cnt);
                PipeBarrier<PIPE_V>();
            }

            StoreTile(yG_, absOff, outL_, cnt);

            remain -= cnt;
            colOff += cnt;
        }
    }

private:
    TPipe* pipe_ = nullptr;
    uint32_t rowCount_ = 0;
    uint32_t elemStart_ = 0;
    uint32_t totalElems_ = 0;
    uint32_t D_ = 0;
    uint32_t per32_ = 0;
    bool rowAligned_ = false;
    bool cacheGB_ = false;
    bool keepY_ = false;
    float epsilon_ = 1e-5f;
    float invD_ = 0.0f;
    float rstd_ = 0.0f;

    GM_ADDR outGm_ = nullptr;
    GlobalTensor<T> xG_;
    GlobalTensor<T> rG_;
    GlobalTensor<T> gG_;
    GlobalTensor<T> bG_;
    GlobalTensor<T> yG_;

    TBuf<TPosition::VECIN> bufX_, bufR_, bufG_, bufB_;
    TBuf<TPosition::VECIN> bufOut_;
    TBuf<TPosition::VECIN> bufW0_, bufW1_, bufW2_, bufWS_;
    TBuf<TPosition::VECIN> bufAcc_, bufTmp_;
    TBuf<TPosition::VECIN> bufGC_, bufBC_;
    TBuf<TPosition::VECIN> bufY_;

    LocalTensor<T> xL_, rL_, gL_, bL_, outL_;
    LocalTensor<float> yRow_;
    LocalTensor<T> gCache_, bCache_;
    LocalTensor<float> wA_, wB_, wC_, wS_, acc_, tmp_;
};

// ============================================================================
// 对齐行批量路径（group1）：每个核把行按 tile 分组，整 tile 一次搬运 + 整
// tile 宽向量运算；行内平方和折叠到行首 64 lane，再用硬件 WholeReduceSum
// （64 lane -> 1）归约，每组只做一次 V_S/S2V，每行仅读 1 个标量 rstd。
//   - D<=384 的 fp16/bf16：整 tile 批量 pass2（Gather 展开 rstd + γ/β 铺行）。
//   - 384<D<=2048：ProcessTile 整 tile 归约，pass2 按行 FMA（γ/β 整行常驻）。
//   - D>2048：宽行窗口化 UltraRow（fp32 D<=32768、fp16/bf16 D<=32768），
//     pass1 逐窗口折 sq 进 64 lane，pass2 逐窗口重读并流式应用 γ/β。
// 非 64 整数倍的尾部窗口单独折叠进行首，保证归约正确。
// ============================================================================
template <typename T>
class AddRmsNormBiasGroup {
public:
    // 单 tile 最多元素：fp32 缓冲占 4B/元素，容量上限需适配 UB（约 192KB）。
    static constexpr uint32_t GT_ELEMS = (sizeof(T) == sizeof(float)) ? 4096U : 8192U;
    static constexpr uint32_t GT_ROWS_MAX = GT_ELEMS / 64U;   // D>=64 时单 tile 最多行
    static constexpr uint32_t FULL_D = 2048;                  // γ/β 整行常驻 UB 的 D 上限
    static constexpr uint32_t PARAM_STRIPE = 2048;            // 宽 D 的 γ/β 流式分块元素数
    static constexpr uint32_t BATCH_CAP = 6144;               // 批量 pass2（fp16/bf16 !wide）单 tile 元素上限

    __aicore__ inline void Init(GM_ADDR xGm, GM_ADDR rGm, GM_ADDR gGm, GM_ADDR bGm, GM_ADDR yGm,
                                const AddRmsNormBiasTilingData& tiling, TPipe* pipe) {
        pipe_ = pipe;
        D_ = tiling.D;
        epsilon_ = tiling.epsilon;
        invD_ = tiling.invD;
        wide_ = (D_ > FULL_D);
        ultra_ = (D_ > GT_ELEMS);
        uint32_t blockIdx = GetBlockIdx();
        uint32_t startRow = blockIdx * tiling.blockRows;
        uint32_t rowsLeft = (startRow < tiling.totalRows) ? (tiling.totalRows - startRow) : 0;
        rowCount_ = (rowsLeft < tiling.blockRows) ? rowsLeft : tiling.blockRows;
        elemStart_ = startRow * D_;
        totalElems_ = tiling.totalRows * D_;

        xG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(xGm), totalElems_);
        rG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(rGm), totalElems_);
        yG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(yGm), totalElems_);
        gG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gGm), D_);
        bG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bGm), D_);

        batch_ = (sizeof(T) != sizeof(float)) && (!wide_) && (D_ <= 384U);
        uint32_t tileCap = batch_ ? BATCH_CAP : GT_ELEMS;
        rowsPerTile_ = tileCap / D_;
        if (rowsPerTile_ < 1) {
            rowsPerTile_ = 1;
        }
        // 每 launch 的 γ/β/rstd 预铺行数按本核实际行数裁剪：微 case 行数少于
        // 整 tile 时，避免每次 launch 都为整 tile（如 D=64 -> 96 行）做 Init
        // 复制的固定开销。
        if (rowCount_ > 0 && rowsPerTile_ > rowCount_) {
            rowsPerTile_ = rowCount_;
        }

        pipe_->InitBuffer(bufXg_, tileCap * sizeof(T));
        pipe_->InitBuffer(bufRg_, tileCap * sizeof(T));
        pipe_->InitBuffer(bufYf_, tileCap * sizeof(float));
        pipe_->InitBuffer(bufWk_, tileCap * sizeof(float));
        pipe_->InitBuffer(bufOg_, tileCap * sizeof(T));
        pipe_->InitBuffer(bufSum_, GT_ROWS_MAX * sizeof(float));
        pipe_->InitBuffer(bufAcc64_, 64 * sizeof(float));
        if (ultra_) {
            pipe_->InitBuffer(bufXgB_, tileCap * sizeof(T));
            pipe_->InitBuffer(bufRgB_, tileCap * sizeof(T));
        }
        if (batch_) {
            // γ/β 逐行复制 + rstd 展开的 Gather offset 表
            pipe_->InitBuffer(bufRepG_, tileCap * sizeof(float));
            pipe_->InitBuffer(bufRepB_, tileCap * sizeof(float));
            pipe_->InitBuffer(bufOff_, tileCap * sizeof(uint32_t));
        }
        // γ/β：小 D 整行常驻；宽 D 只给一列分块大小
        uint32_t pc = wide_ ? PARAM_STRIPE : D_;
        pipe_->InitBuffer(bufGt_, pc * sizeof(T));
        pipe_->InitBuffer(bufBt_, pc * sizeof(T));
        pipe_->InitBuffer(bufGf_, pc * sizeof(float));
        pipe_->InitBuffer(bufBf_, pc * sizeof(float));

        xg_ = bufXg_.template Get<T>();
        rg_ = bufRg_.template Get<T>();
        yf_ = bufYf_.Get<float>();
        wk_ = bufWk_.Get<float>();
        og_ = bufOg_.template Get<T>();
        sum_ = bufSum_.Get<float>();
        acc64_ = bufAcc64_.Get<float>();
        if (ultra_) {
            xgB_ = bufXgB_.template Get<T>();
            rgB_ = bufRgB_.template Get<T>();
        }
        gt_ = bufGt_.template Get<T>();
        bt_ = bufBt_.template Get<T>();
        gf_ = bufGf_.Get<float>();
        bf_ = bufBf_.Get<float>();
        if (batch_) {
            repG_ = bufRepG_.Get<float>();
            repB_ = bufRepB_.Get<float>();
            off_ = bufOff_.Get<uint32_t>();
        }

        if (!wide_) {
            // γ/β 整行载入并转 fp32（D<=2048，每 kernel 一次，跨 tile 复用）
            PipeBarrier<PIPE_ALL>();
            DataCopy(gt_, gG_, D_);
            DataCopy(bt_, bG_, D_);
            PipeBarrier<PIPE_ALL>();
            gf_ = DtypeOps<T>::ToFp32(gt_, gf_, D_);
            bf_ = DtypeOps<T>::ToFp32(bt_, bf_, D_);
            if (batch_) {
                // repG_/repB_：每行一份 γ/β（fp32 行宽 D_，rowsPerTile_ 份）
                for (uint32_t r = 0; r < rowsPerTile_; r++) {
                    Adds(repG_[r * D_], gf_, 0.0f, D_);
                    PipeBarrier<PIPE_V>();
                    Adds(repB_[r * D_], bf_, 0.0f, D_);
                    PipeBarrier<PIPE_V>();
                    Duplicate(off_[r * D_], r * 4U, D_);
                    PipeBarrier<PIPE_V>();
                }
            }
        }
    }

    __aicore__ inline void Process() {
        if (ultra_) {
            uint32_t baseRow = elemStart_ / D_;
            for (uint32_t r = 0; r < rowCount_; r++) {
                UltraRow(baseRow + r);
            }
            return;
        }
        uint32_t rowDone = 0;
        while (rowDone < rowCount_) {
            uint32_t g = rowCount_ - rowDone;
            if (g > rowsPerTile_) {
                g = rowsPerTile_;
            }
            if (batch_) {
                ProcessTileBatch(rowDone, g);
            } else {
                ProcessTile(rowDone, g);
            }
            rowDone += g;
        }
    }

private:
    // 载入 γ/β 的 [colOff, colOff+len) 分块并转 fp32
    __aicore__ inline void LoadGBC(uint32_t colOff, uint32_t len, FalseType) {
        PipeBarrier<PIPE_ALL>();
        DataCopy(gt_, gG_[colOff], len);
        DataCopy(bt_, bG_[colOff], len);
        PipeBarrier<PIPE_ALL>();
        DtypeOps<T>::ToFp32(gt_, gf_, len);
        DtypeOps<T>::ToFp32(bt_, bf_, len);
    }
    __aicore__ inline void LoadGBC(uint32_t colOff, uint32_t len, TrueType) {
        PipeBarrier<PIPE_ALL>();
        DataCopy(gt_, gG_[colOff], len);
        DataCopy(bt_, bG_[colOff], len);
        PipeBarrier<PIPE_ALL>();
        gf_ = gt_;
        bf_ = bt_;
    }

    // ============ 超宽行窗口化（对齐行 D>GT_ELEMS，UltraRow 双缓冲） ============
    // UB 放不下整行时按 GT_ELEMS 宽度的窗口两次读 x/residual：pass1 逐窗口把 sq 折到
    // 64 lane 累加进 acc64_，得到整行 rstd；pass2 逐窗口重读 x/residual、乘 rstd、
    // 按 PARAM_STRIPE 载入 γ/β 后 FMA 并写出。
    __aicore__ inline void FoldHead64(LocalTensor<float> buf, uint32_t len) {
        uint32_t body = 1U;
        while ((body << 1) <= len) {
            body <<= 1;
        }
        uint32_t tail = len - body;
        if (tail != 0) {
            Add(buf, buf, buf[body], tail);
            PipeBarrier<PIPE_V>();
        }
        while (body > 64U) {
            body >>= 1;
            Add(buf, buf, buf[body], body);
            PipeBarrier<PIPE_V>();
        }
    }

    __aicore__ inline void UltraRow(uint32_t rowG) {
        uint32_t W = GT_ELEMS;
        uint32_t lastLen = D_ % W;
        if (lastLen == 0) {
            lastLen = W;
        }
        uint32_t nWin = (D_ + W - 1) / W;
        uint32_t gmBase = rowG * D_;

        // ---- pass1：双缓冲逐窗口 sq -> fold 进 acc64_ ----
        // 迭代顶部异步预取下一窗口（MTE2），期间与本次窗口的 V 计算重叠；
        // 迭代末 PIPE_ALL 同时保证 ①V 用完当前 buffer 可复用 ②下一窗口 MTE2 已完成。
        Duplicate(acc64_, 0.0f, 64);
        PipeBarrier<PIPE_V>();
        LoadXY(xg_, rg_, gmBase, D_ >= W ? W : D_);
        for (uint32_t w = 0; w < nWin; w++) {
            uint32_t col = w * W;
            uint32_t len = (w == nWin - 1) ? lastLen : W;
            LocalTensor<T> xc = ((w & 1U) == 0U) ? xg_ : xgB_;
            LocalTensor<T> rc = ((w & 1U) == 0U) ? rg_ : rgB_;
            if (w + 1 < nWin) {
                uint32_t ncol = (w + 1) * W;
                uint32_t nlen = (w + 1 == nWin - 1) ? lastLen : W;
                if ((w & 1U) == 0U) {
                    LoadXYAsync(xgB_, rgB_, gmBase + ncol, nlen);
                } else {
                    LoadXYAsync(xg_, rg_, gmBase + ncol, nlen);
                }
            }
            ComputeYsqWin(xc, rc, len, typename DtypeOps<T>::IsFloat());
            if (len >= 64U) {
                FoldHead64(wk_, len);
                Add(acc64_, acc64_, wk_, 64);
            } else {
                Add(acc64_, acc64_, wk_, len);
            }
            PipeBarrier<PIPE_ALL>();
        }

        // 整行 sum -> rstd
        WholeReduceSum<float, true>(sum_, acc64_, 64, 1, 0, 1, 0);
        Muls(sum_, sum_, invD_, 1);
        Adds(sum_, sum_, epsilon_, 1);
        Sqrt(sum_, sum_, 1);
        Duplicate(wk_, 1.0f, 1);
        Div(sum_, wk_, sum_, 1);
        PipeBarrier<PIPE_V>();
        SyncV2S();
        rstdLast_ = sum_.GetValue(0);
        SyncS2V();

        // ---- pass2：双缓冲逐窗口重读 x/residual 计算输出 ----
        LoadXY(xg_, rg_, gmBase, D_ >= W ? W : D_);
        for (uint32_t w = 0; w < nWin; w++) {
            uint32_t col = w * W;
            uint32_t len = (w == nWin - 1) ? lastLen : W;
            LocalTensor<T> xc = ((w & 1U) == 0U) ? xg_ : xgB_;
            LocalTensor<T> rc = ((w & 1U) == 0U) ? rg_ : rgB_;
            if (w + 1 < nWin) {
                uint32_t ncol = (w + 1) * W;
                uint32_t nlen = (w + 1 == nWin - 1) ? lastLen : W;
                if ((w & 1U) == 0U) {
                    LoadXYAsync(xgB_, rgB_, gmBase + ncol, nlen);
                } else {
                    LoadXYAsync(xg_, rg_, gmBase + ncol, nlen);
                }
            }
            ComputeYfWin(xc, rc, len, typename DtypeOps<T>::IsFloat());
            // 窗口内按 2048 列分块应用 γ/β
            uint32_t sub = 0;
            while (sub < len) {
                uint32_t sl = len - sub;
                if (sl > PARAM_STRIPE) {
                    sl = PARAM_STRIPE;
                }
                LoadGBC(col + sub, sl, typename DtypeOps<T>::IsFloat());
                FusedMulAdd(yf_[sub], gf_, bf_, sl);
                PipeBarrier<PIPE_V>();
                sub += sl;
            }
            StoreWinOut(gmBase + col, len, typename DtypeOps<T>::IsFloat());
            if (w + 1 < nWin) {
                PipeBarrier<PIPE_ALL>();
            }
        }
    }
    __aicore__ inline void StoreWinOut(uint32_t gmOff, uint32_t len, FalseType) {
        DtypeOps<T>::Store(og_, yf_, len);
        PipeBarrier<PIPE_ALL>();
        DataCopy(yG_[gmOff], og_, len);
        PipeBarrier<PIPE_ALL>();
    }
    __aicore__ inline void StoreWinOut(uint32_t gmOff, uint32_t len, TrueType) {
        PipeBarrier<PIPE_ALL>();
        DataCopy(yG_[gmOff], yf_, len);
        PipeBarrier<PIPE_ALL>();
    }
    // 双缓冲加载（带屏障版本：先等前一轮用完 buffer）
    __aicore__ inline void LoadXY(LocalTensor<T> xb, LocalTensor<T> rb, uint32_t gmOff, uint32_t len) {
        PipeBarrier<PIPE_ALL>();
        DataCopy(xb, xG_[gmOff], len);
        DataCopy(rb, rG_[gmOff], len);
        PipeBarrier<PIPE_ALL>();
    }
    __aicore__ inline void LoadXYAsync(LocalTensor<T> xb, LocalTensor<T> rb, uint32_t gmOff, uint32_t len) {
        DataCopy(xb, xG_[gmOff], len);
        DataCopy(rb, rG_[gmOff], len);
    }
    // sq 到 wk_（fp16 先转 fp32）
    __aicore__ inline void ComputeYsqWin(LocalTensor<T> xc, LocalTensor<T> rc, uint32_t len, FalseType) {
        DtypeOps<T>::ToFp32(xc, yf_, len);
        DtypeOps<T>::ToFp32(rc, wk_, len);
        Add(yf_, yf_, wk_, len);
        PipeBarrier<PIPE_V>();
        Mul(wk_, yf_, yf_, len);
        PipeBarrier<PIPE_V>();
    }
    __aicore__ inline void ComputeYsqWin(LocalTensor<T> xc, LocalTensor<T> rc, uint32_t len, TrueType) {
        Add(yf_, xc, rc, len);
        PipeBarrier<PIPE_V>();
        Mul(wk_, yf_, yf_, len);
        PipeBarrier<PIPE_V>();
    }
    // pass2：y=x+r 到 yf_
    __aicore__ inline void ComputeYfWin(LocalTensor<T> xc, LocalTensor<T> rc, uint32_t len, FalseType) {
        DtypeOps<T>::ToFp32(xc, yf_, len);
        DtypeOps<T>::ToFp32(rc, wk_, len);
        Add(yf_, yf_, wk_, len);
        PipeBarrier<PIPE_V>();
        Muls(yf_, yf_, rstdLast_, len);
        PipeBarrier<PIPE_V>();
    }
    __aicore__ inline void ComputeYfWin(LocalTensor<T> xc, LocalTensor<T> rc, uint32_t len, TrueType) {
        Add(yf_, xc, rc, len);
        PipeBarrier<PIPE_V>();
        Muls(yf_, yf_, rstdLast_, len);
        PipeBarrier<PIPE_V>();
    }
    // ============ 批量 pass2（fp16/bf16、D<=2048 对齐行） ============
    // 逐行标量 GetValue/逐行 Muls/FMA/Cast 是这类 case 的主要耗时（标量+短向量指令
    // 串行），这里改成：整 tile 连续 fp32 运算 + Gather 展开每行 rstd + γ/β 整 tile
    // 复制后一次 FusedMulAdd，最后整 tile 一次 Cast + MTE3。
    __aicore__ inline void ProcessTileBatch(uint32_t rowOffInBlock, uint32_t g) {
        uint32_t tileElems = g * D_;
        uint32_t gmOff = elemStart_ + rowOffInBlock * D_;

        PipeBarrier<PIPE_ALL>();
        DataCopy(xg_, xG_[gmOff], tileElems);
        DataCopy(rg_, rG_[gmOff], tileElems);
        PipeBarrier<PIPE_ALL>();

        // y = x + r（fp32），sq = y^2（fp32）
        DtypeOps<T>::ToFp32(xg_, yf_, tileElems);
        DtypeOps<T>::ToFp32(rg_, wk_, tileElems);
        Add(yf_, yf_, wk_, tileElems);
        PipeBarrier<PIPE_V>();
        Mul(wk_, yf_, yf_, tileElems);
        PipeBarrier<PIPE_V>();

        // 每行 fold 到行首 64 lane，再一次性硬件 WholeReduceSum（repeat=g）
        RowReduceTo64(g);
        WholeReduceSum<float, true>(sum_, wk_, 64, g, 1, 1, D_ / 8);

        // rstd = 1/sqrt(mean+eps)，G 行连续向量
        Muls(sum_, sum_, invD_, g);
        Adds(sum_, sum_, epsilon_, g);
        Sqrt(sum_, sum_, g);
        Duplicate(wk_, 1.0f, g);
        Div(sum_, wk_, sum_, g);
        PipeBarrier<PIPE_V>();

        // 用 off_ 把每行 rstd 展开成整行（vector 域，无 V_S/GetValue）
        Gather(wk_, sum_, off_, 0U, tileElems);
        PipeBarrier<PIPE_V>();

        // out = (y * rstd) * γ + β，全 tile 大向量
        Mul(yf_, yf_, wk_, tileElems);
        PipeBarrier<PIPE_V>();
        FusedMulAdd(yf_, repG_, repB_, tileElems);
        PipeBarrier<PIPE_V>();
        // fp32 -> fp16 一次性 round 并整 tile 写回
        DtypeOps<T>::Store(og_, yf_, tileElems);
        PipeBarrier<PIPE_ALL>();
        DataCopy(yG_[gmOff], og_, tileElems);
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void ProcessTile(uint32_t rowOffInBlock, uint32_t g) {
        uint32_t tileElems = g * D_;
        uint32_t gmOff = elemStart_ + rowOffInBlock * D_;

        // 整 tile 连续搬运（行连续且行首 32B 对齐 -> tile 全部 32B 对齐）
        PipeBarrier<PIPE_ALL>();
        DataCopy(xg_, xG_[gmOff], tileElems);
        DataCopy(rg_, rG_[gmOff], tileElems);
        PipeBarrier<PIPE_ALL>();

        // y = x + r（整 tile fp32）；sq = y^2
        ComputeYsq(tileElems, typename DtypeOps<T>::IsFloat());

        // 行内平方和 -> 每行前 64 lane（整行 log 深度树形归约，避免逐 64-lane
        // 串行折叠的长依赖链；非 2 幂行先折尾部到行首再逐级减半）
        RowReduceTo64(g);
        // 硬件归约：每行 64 lane -> 1 个标量
        for (uint32_t r = 0; r < g; r++) {
            WholeReduceSum<float, true>(sum_[r], wk_[r * D_], 64, 1, 0, 1, 0);
        }

        // rstd = 1/sqrt(mean(sq)+eps)，G 行批量向量计算
        Muls(sum_, sum_, invD_, g);
        Adds(sum_, sum_, epsilon_, g);
        Sqrt(sum_, sum_, g);
        Duplicate(wk_, 1.0f, g);
        Div(sum_, wk_, sum_, g);

        // 一次 V_S；随后每行读 rstd 标量并执行 pass2
        SyncV2S();
        for (uint32_t c = 0; c < D_; c += PARAM_STRIPE) {
            uint32_t len = D_ - c;
            if (len > PARAM_STRIPE) {
                len = PARAM_STRIPE;
            }
            if (wide_) {
                LoadGBC(c, len, typename DtypeOps<T>::IsFloat());
            }
            for (uint32_t r = 0; r < g; r++) {
                float rstd = sum_.GetValue(r);
                ScaleFmaStore(r, c, len, rstd, typename DtypeOps<T>::IsFloat());
            }
        }
        SyncS2V();

        // 整 tile 写回（fp16/bf16 用 cast 后的 og_，fp32 直接用 wk_）
        StageAndStore(gmOff, tileElems, typename DtypeOps<T>::IsFloat());
    }

    // 行 r 的 [col, col+len) 段：out = (y*rstd)*γ + β，并写回（half 走 og_ cast）
    __aicore__ inline void ScaleFmaStore(uint32_t r, uint32_t col, uint32_t len, float rstd, FalseType) {
        LocalTensor<float> out = wk_[r * D_ + col];
        Muls(out, yf_[r * D_ + col], rstd, len);
        PipeBarrier<PIPE_V>();
        FusedMulAdd(out, gf_, bf_, len);
        PipeBarrier<PIPE_V>();
        LocalTensor<T> outT = og_[r * D_ + col];
        DtypeOps<T>::Store(outT, out, len);
    }
    __aicore__ inline void ScaleFmaStore(uint32_t r, uint32_t col, uint32_t len, float rstd, TrueType) {
        LocalTensor<float> out = wk_[r * D_ + col];
        Muls(out, yf_[r * D_ + col], rstd, len);
        PipeBarrier<PIPE_V>();
        FusedMulAdd(out, gf_, bf_, len);
        PipeBarrier<PIPE_V>();
    }

    // 把每行 D_ 个 sq 元素归约到该行首 64 lane（就地树形归约）：
    //   1) 若 D 非 2 的幂，先把 [body, D) 尾部加到行首（同属本行，不跨界）；
    //   2) 逐级 body 减半，src[body,2body) -> dst[0,body)，直到 64。
    __aicore__ inline void RowReduceTo64(uint32_t g) {
        for (uint32_t r = 0; r < g; r++) {
            LocalTensor<float> row = wk_[r * D_];
            uint32_t body = 1U;
            while ((body << 1) <= D_) {
                body <<= 1;
            }
            uint32_t tail = D_ - body;
            if (tail != 0) {
                Add(row, row, wk_[r * D_ + body], tail);
                PipeBarrier<PIPE_V>();
            }
            while (body > 64U) {
                body >>= 1;
                Add(row, row, wk_[r * D_ + body], body);
                PipeBarrier<PIPE_V>();
            }
        }
    }

    __aicore__ inline void ComputeYsq(uint32_t tileElems, FalseType) {
        DtypeOps<T>::ToFp32(xg_, yf_, tileElems);
        DtypeOps<T>::ToFp32(rg_, wk_, tileElems);
        Add(yf_, yf_, wk_, tileElems);
        Mul(wk_, yf_, yf_, tileElems);
    }
    __aicore__ inline void ComputeYsq(uint32_t tileElems, TrueType) {
        Adds(yf_, xg_, 0.0f, tileElems);
        Add(yf_, yf_, rg_, tileElems);
        Mul(wk_, yf_, yf_, tileElems);
    }

    __aicore__ inline void StageAndStore(uint32_t gmOff, uint32_t tileElems, FalseType) {
        PipeBarrier<PIPE_ALL>();
        DataCopy(yG_[gmOff], og_, tileElems);
        PipeBarrier<PIPE_ALL>();
    }
    __aicore__ inline void StageAndStore(uint32_t gmOff, uint32_t tileElems, TrueType) {
        PipeBarrier<PIPE_ALL>();
        DataCopy(yG_[gmOff], wk_, tileElems);
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void SyncV2S() {
        event_t ev = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(ev);
        WaitFlag<HardEvent::V_S>(ev);
    }
    __aicore__ inline void SyncS2V() {
        event_t ev = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));
        SetFlag<HardEvent::S_V>(ev);
        WaitFlag<HardEvent::S_V>(ev);
    }

private:
    TPipe* pipe_ = nullptr;
    uint32_t rowCount_ = 0;
    uint32_t elemStart_ = 0;
    uint32_t totalElems_ = 0;
    uint32_t D_ = 0;
    bool wide_ = false;
    float epsilon_ = 1e-5f;
    float invD_ = 0.0f;

    GlobalTensor<T> xG_;
    GlobalTensor<T> rG_;
    GlobalTensor<T> gG_;
    GlobalTensor<T> bG_;
    GlobalTensor<T> yG_;

    TBuf<TPosition::VECIN> bufXg_, bufRg_, bufOg_;
    TBuf<TPosition::VECIN> bufGt_, bufBt_;
    TBuf<TPosition::VECIN> bufYf_, bufWk_, bufGf_, bufBf_, bufSum_;
    TBuf<TPosition::VECIN> bufRepG_, bufRepB_, bufOff_, bufAcc64_;
    TBuf<TPosition::VECIN> bufXgB_, bufRgB_;

    LocalTensor<T> xg_, rg_, og_, gt_, bt_;
    LocalTensor<float> yf_, wk_, gf_, bf_, sum_;
    LocalTensor<float> repG_, repB_;
    LocalTensor<uint32_t> off_;
    LocalTensor<float> acc64_;
    LocalTensor<T> xgB_, rgB_;
    uint32_t rowsPerTile_ = 0;
    bool batch_ = false;
    bool ultra_ = false;
    float rstdLast_ = 0.0f;
};


// ============================================================================
// 非对齐行 padded-tile 路径（group2，行首在 GM/UB 均非 32B 对齐）：行在 UB
// 内按 rowPad=align64(D) 填零对齐存放，向量运算/归约全程在 padding 空间进行
// （pad lane 恒为 0，不污染行内和），γ/β 同法补零；只在 GM 侧按每行精确 D
// 个元素 DataCopyPad 读写。解决旧逐行路径“一行一同步、密集小指令”的开销。
// ============================================================================
template <typename T>
class AddRmsNormBiasPad {
public:
    static constexpr uint32_t CAP_FP = (sizeof(T) == sizeof(float)) ? 4096U : 8192U;
    static constexpr uint32_t BATCH_TILE = 6144;  // 批量 pass2 整 tile fp32 元素预算

    __aicore__ inline void Init(GM_ADDR xGm, GM_ADDR rGm, GM_ADDR gGm, GM_ADDR bGm, GM_ADDR yGm,
                                const AddRmsNormBiasTilingData& tiling, TPipe* pipe) {
        pipe_ = pipe;
        D_ = tiling.D;
        rowPad_ = ((D_ + 63U) / 64U) * 64U;
        capRows_ = CAP_FP / rowPad_;
        if (capRows_ < 1) {
            capRows_ = 1;
        }
        // fp16/bf16 走批量 pass2（与 group 的 batch 路径一致）：整 tile 单次
        // WholeReduceSum(repeat=g) + Gather 展开 rstd + 整 tile 大向量 FMA，
        // 消除逐行 WholeReduceSum/标量同步/短向量。tile 元素数压到 BATCH_TILE
        // 预算以内，UB 容得下 repG/repB/off 三张表。
        batch_ = (sizeof(T) != sizeof(float));
        if (batch_) {
            uint32_t rowsCap = BATCH_TILE / rowPad_;
            if (rowsCap < capRows_) {
                capRows_ = rowsCap;
            }
            if (capRows_ < 1) {
                capRows_ = 1;
            }
        }
        epsilon_ = tiling.epsilon;
        invD_ = tiling.invD;
        uint32_t blockIdx = GetBlockIdx();
        uint32_t startRow = blockIdx * tiling.blockRows;
        uint32_t rowsLeft = (startRow < tiling.totalRows) ? (tiling.totalRows - startRow) : 0;
        rowCount_ = (rowsLeft < tiling.blockRows) ? rowsLeft : tiling.blockRows;
        elemStart_ = startRow * D_;
        totalElems_ = tiling.totalRows * D_;
        rowsPerTile_ = capRows_;
        if (rowCount_ > 0 && rowsPerTile_ > rowCount_) {
            rowsPerTile_ = rowCount_;
        }

        xG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(xGm), totalElems_);
        rG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(rGm), totalElems_);
        yG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(yGm), totalElems_);
        gG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gGm), D_);
        bG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bGm), D_);

        uint32_t capPad = capRows_ * rowPad_;
        pipe_->InitBuffer(bufXg_, capPad * sizeof(T));
        pipe_->InitBuffer(bufRg_, capPad * sizeof(T));
        pipe_->InitBuffer(bufYf_, capPad * sizeof(float));
        pipe_->InitBuffer(bufWk_, capPad * sizeof(float));
        pipe_->InitBuffer(bufOg_, capPad * sizeof(T));
        pipe_->InitBuffer(bufGt_, rowPad_ * sizeof(T));
        pipe_->InitBuffer(bufBt_, rowPad_ * sizeof(T));
        pipe_->InitBuffer(bufGf_, rowPad_ * sizeof(float));
        pipe_->InitBuffer(bufBf_, rowPad_ * sizeof(float));
        pipe_->InitBuffer(bufSum_, capRows_ * sizeof(float));
        if (batch_) {
            pipe_->InitBuffer(bufRepG_, capPad * sizeof(float));
            pipe_->InitBuffer(bufRepB_, capPad * sizeof(float));
            pipe_->InitBuffer(bufOff_, capPad * sizeof(uint32_t));
        }

        xg_ = bufXg_.template Get<T>();
        rg_ = bufRg_.template Get<T>();
        yf_ = bufYf_.Get<float>();
        wk_ = bufWk_.Get<float>();
        og_ = bufOg_.template Get<T>();
        gt_ = bufGt_.template Get<T>();
        bt_ = bufBt_.template Get<T>();
        gf_ = bufGf_.Get<float>();
        bf_ = bufBf_.Get<float>();
        sum_ = bufSum_.Get<float>();
        if (batch_) {
            repG_ = bufRepG_.Get<float>();
            repB_ = bufRepB_.Get<float>();
            off_ = bufOff_.Get<uint32_t>();
        }

        // γ/β 补零填充后按 rowPad 转 fp32（pad lane=0，FMA 不污染输出 pad）
        PipeBarrier<PIPE_ALL>();
        Duplicate(gt_, T(0), rowPad_);
        Duplicate(bt_, T(0), rowPad_);
        PipeBarrier<PIPE_ALL>();
        LoadPadParam(gG_, gt_, bG_, bt_);
        PipeBarrier<PIPE_ALL>();
        gf_ = DtypeOps<T>::ToFp32(gt_, gf_, rowPad_);
        bf_ = DtypeOps<T>::ToFp32(bt_, bf_, rowPad_);
        if (batch_) {
            // repG_/repB_：每行一份 γ/β（fp32 行宽 rowPad_）；off_：每行 rstd
            // 源字节偏移表（r*4）。tile 内行号从 0 计，所有 tile 复用同一张表。
            for (uint32_t r = 0; r < rowsPerTile_; r++) {
                Adds(repG_[r * rowPad_], gf_, 0.0f, rowPad_);
                PipeBarrier<PIPE_V>();
                Adds(repB_[r * rowPad_], bf_, 0.0f, rowPad_);
                PipeBarrier<PIPE_V>();
                Duplicate(off_[r * rowPad_], r * 4U, rowPad_);
                PipeBarrier<PIPE_V>();
            }
        }
    }

    __aicore__ inline void Process() {
        uint32_t rowDone = 0;
        while (rowDone < rowCount_) {
            uint32_t g = rowCount_ - rowDone;
            uint32_t tileRows = batch_ ? rowsPerTile_ : capRows_;
            if (g > tileRows) {
                g = tileRows;
            }
            if (batch_) {
                ProcessTilePadBatch(rowDone, g);
            } else {
                ProcessTile(rowDone, g);
            }
            rowDone += g;
        }
    }

private:
    __aicore__ inline void LoadPadParam(GlobalTensor<T>& gG, LocalTensor<T> dstG,
                                        GlobalTensor<T>& bG, LocalTensor<T> dstB) {
        DataCopyExtParams cp;
        cp.blockCount = 1;
        cp.blockLen = D_ * static_cast<uint32_t>(sizeof(T));
        cp.srcStride = 0;
        cp.dstStride = 0;
        cp.rsv = 0;
        DataCopyPadExtParams<T> pp;
        pp.isPad = true;
        pp.leftPadding = 0;
        pp.rightPadding = TailPadElems();
        pp.paddingValue = T(0);
        DataCopyPad(dstG, gG[0], cp, pp);
        DataCopyPad(dstB, bG[0], cp, pp);
    }

    // 单行 load：src GM 行首可能非 32B 对齐，dst UB 行槽 32B 对齐
    __aicore__ inline void LoadRow(GlobalTensor<T>& g, uint32_t gOff, LocalTensor<T> dst) {
        DataCopyExtParams cp;
        cp.blockCount = 1;
        cp.blockLen = D_ * static_cast<uint32_t>(sizeof(T));
        cp.srcStride = 0;
        cp.dstStride = 0;
        cp.rsv = 0;
        DataCopyPadExtParams<T> pp;
        pp.isPad = true;
        pp.leftPadding = 0;
        pp.rightPadding = TailPadElems();
        pp.paddingValue = T(0);
        DataCopyPad(dst, g[gOff], cp, pp);
    }
    // 本行 D*elemSize 末尾到 32B 边界需要的补零元素数
    __aicore__ inline uint32_t TailPadElems() {
        uint32_t rem = (D_ * static_cast<uint32_t>(sizeof(T))) & 31U;
        return rem == 0U ? 0U : (32U - rem) / static_cast<uint32_t>(sizeof(T));
    }

    __aicore__ inline void StoreRow(uint32_t gmOff, LocalTensor<T> src) {
        DataCopyExtParams cp;
        cp.blockCount = 1;
        cp.blockLen = D_ * static_cast<uint32_t>(sizeof(T));
        cp.srcStride = 0;
        cp.dstStride = 0;
        cp.rsv = 0;
        DataCopyPad(yG_[gmOff], src, cp);
    }

    // 批量 pass2（fp16/bf16）：整 tile 一次归约 + 整 tile 大向量输出，
    // 无逐行 WholeReduceSum/GetValue 标量往返。
    __aicore__ inline void ProcessTilePadBatch(uint32_t rowOffInBlock, uint32_t g) {
        uint32_t gPad = g * rowPad_;
        uint32_t gmBase = elemStart_ + rowOffInBlock * D_;

        PipeBarrier<PIPE_ALL>();
        Duplicate(xg_, T(0), gPad);
        Duplicate(rg_, T(0), gPad);
        PipeBarrier<PIPE_ALL>();
        for (uint32_t r = 0; r < g; r++) {
            LoadRow(xG_, gmBase + r * D_, xg_[r * rowPad_]);
            LoadRow(rG_, gmBase + r * D_, rg_[r * rowPad_]);
        }
        PipeBarrier<PIPE_ALL>();

        // y = x+r（fp32 tile）；sq = y^2
        ComputeYsq(gPad, typename DtypeOps<T>::IsFloat());
        // 每行 fold 到行首 64 lane，再一次性硬件 WholeReduceSum（repeat=g，
        // 源行距 rowPad_ 个 fp32 元素）
        RowReduceTo64(g);
        WholeReduceSum<float, true>(sum_, wk_, 64, g, 1, 1, rowPad_ / 8);

        // rstd = 1/sqrt(mean+eps)，G 行连续向量
        Muls(sum_, sum_, invD_, g);
        Adds(sum_, sum_, epsilon_, g);
        Sqrt(sum_, sum_, g);
        Duplicate(wk_, 1.0f, g);
        Div(sum_, wk_, sum_, g);
        PipeBarrier<PIPE_V>();

        // 用 off_ 把每行 rstd 展开成整行（vector 域，无 V_S/GetValue）
        Gather(wk_, sum_, off_, 0U, gPad);
        PipeBarrier<PIPE_V>();

        // out = (y * rstd) * γ + β，全 tile 大向量（γ/β 已按行复制到 repG_/repB_）
        Mul(yf_, yf_, wk_, gPad);
        PipeBarrier<PIPE_V>();
        FusedMulAdd(yf_, repG_, repB_, gPad);
        PipeBarrier<PIPE_V>();
        // 一次性 round 回原类型
        DtypeOps<T>::Store(og_, yf_, gPad);
        PipeBarrier<PIPE_ALL>();
        for (uint32_t r = 0; r < g; r++) {
            StoreRow(gmBase + r * D_, og_[r * rowPad_]);
        }
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void ProcessTile(uint32_t rowOffInBlock, uint32_t g) {
        uint32_t gPad = g * rowPad_;
        uint32_t gmBase = elemStart_ + rowOffInBlock * D_;

        // 行槽清零（保证 pad lane 与上次残留数据不污染）
        PipeBarrier<PIPE_ALL>();
        Duplicate(xg_, T(0), gPad);
        Duplicate(rg_, T(0), gPad);
        PipeBarrier<PIPE_ALL>();
        for (uint32_t r = 0; r < g; r++) {
            LoadRow(xG_, gmBase + r * D_, xg_[r * rowPad_]);
            LoadRow(rG_, gmBase + r * D_, rg_[r * rowPad_]);
        }
        PipeBarrier<PIPE_ALL>();

        ComputeYsq(gPad, typename DtypeOps<T>::IsFloat());

        // 每行（长度 rowPad_，64 的倍数）树形归约到行首 64 lane
        RowReduceTo64(g);
        for (uint32_t r = 0; r < g; r++) {
            WholeReduceSum<float, true>(sum_[r], wk_[r * rowPad_], 64, 1, 0, 1, 0);
        }

        Muls(sum_, sum_, invD_, g);
        Adds(sum_, sum_, epsilon_, g);
        Sqrt(sum_, sum_, g);
        Duplicate(wk_, 1.0f, g);
        Div(sum_, wk_, sum_, g);

        SyncV2S();
        for (uint32_t r = 0; r < g; r++) {
            float rstd = sum_.GetValue(r);
            ScaleFmaStore(r, rstd, typename DtypeOps<T>::IsFloat());
        }
        SyncS2V();

        PipeBarrier<PIPE_ALL>();
        for (uint32_t r = 0; r < g; r++) {
            StoreRow(gmBase + r * D_, RowOut(r, typename DtypeOps<T>::IsFloat()));
        }
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void ScaleFmaStore(uint32_t r, float rstd, FalseType) {
        LocalTensor<float> out = wk_[r * rowPad_];
        Muls(out, yf_[r * rowPad_], rstd, rowPad_);
        PipeBarrier<PIPE_V>();
        FusedMulAdd(out, gf_, bf_, rowPad_);
        PipeBarrier<PIPE_V>();
        LocalTensor<T> outT = og_[r * rowPad_];
        DtypeOps<T>::Store(outT, out, rowPad_);
    }
    __aicore__ inline void ScaleFmaStore(uint32_t r, float rstd, TrueType) {
        LocalTensor<float> out = wk_[r * rowPad_];
        Muls(out, yf_[r * rowPad_], rstd, rowPad_);
        PipeBarrier<PIPE_V>();
        FusedMulAdd(out, gf_, bf_, rowPad_);
        PipeBarrier<PIPE_V>();
    }
    __aicore__ inline LocalTensor<T> RowOut(uint32_t r, FalseType) { return og_[r * rowPad_]; }
    __aicore__ inline LocalTensor<float> RowOut(uint32_t r, TrueType) { return wk_[r * rowPad_]; }

    __aicore__ inline void ComputeYsq(uint32_t tilePad, FalseType) {
        DtypeOps<T>::ToFp32(xg_, yf_, tilePad);
        DtypeOps<T>::ToFp32(rg_, wk_, tilePad);
        Add(yf_, yf_, wk_, tilePad);
        Mul(wk_, yf_, yf_, tilePad);
    }
    __aicore__ inline void ComputeYsq(uint32_t tilePad, TrueType) {
        Adds(yf_, xg_, 0.0f, tilePad);
        Add(yf_, yf_, rg_, tilePad);
        Mul(wk_, yf_, yf_, tilePad);
    }

    __aicore__ inline void RowReduceTo64(uint32_t g) {
        for (uint32_t r = 0; r < g; r++) {
            LocalTensor<float> row = wk_[r * rowPad_];
            uint32_t body = 1U;
            while ((body << 1) <= rowPad_) {
                body <<= 1;
            }
            uint32_t tail = rowPad_ - body;
            if (tail != 0) {
                Add(row, row, wk_[r * rowPad_ + body], tail);
                PipeBarrier<PIPE_V>();
            }
            while (body > 64U) {
                body >>= 1;
                Add(row, row, wk_[r * rowPad_ + body], body);
                PipeBarrier<PIPE_V>();
            }
        }
    }

    __aicore__ inline void SyncV2S() {
        event_t ev = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(ev);
        WaitFlag<HardEvent::V_S>(ev);
    }
    __aicore__ inline void SyncS2V() {
        event_t ev = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));
        SetFlag<HardEvent::S_V>(ev);
        WaitFlag<HardEvent::S_V>(ev);
    }

private:
    TPipe* pipe_ = nullptr;
    uint32_t rowCount_ = 0;
    uint32_t rowPad_ = 0;
    uint32_t capRows_ = 0;
    uint32_t elemStart_ = 0;
    uint32_t totalElems_ = 0;
    uint32_t D_ = 0;
    float epsilon_ = 1e-5f;
    float invD_ = 0.0f;

    GlobalTensor<T> xG_;
    GlobalTensor<T> rG_;
    GlobalTensor<T> gG_;
    GlobalTensor<T> bG_;
    GlobalTensor<T> yG_;

    TBuf<TPosition::VECIN> bufXg_, bufRg_, bufOg_;
    TBuf<TPosition::VECIN> bufGt_, bufBt_;
    TBuf<TPosition::VECIN> bufYf_, bufWk_, bufGf_, bufBf_, bufSum_;
    TBuf<TPosition::VECIN> bufRepG_, bufRepB_, bufOff_, bufAcc64_;
    TBuf<TPosition::VECIN> bufXgB_, bufRgB_;

    LocalTensor<T> xg_, rg_, og_, gt_, bt_;
    LocalTensor<float> yf_, wk_, gf_, bf_, sum_;
    LocalTensor<float> repG_, repB_;
    LocalTensor<uint32_t> off_;
    LocalTensor<float> acc64_;
    LocalTensor<T> xgB_, rgB_;
    uint32_t rowsPerTile_ = 0;
    bool batch_ = false;
    bool ultra_ = false;
    float rstdLast_ = 0.0f;
};

// ============================================================================
// 非对齐宽行路径（group3，非对齐且 D>2048 直到 32768）：逐行窗口化两遍处理，
// 结构与 group1 的 UltraRow 一致（pass1 逐窗口折 sq 进 acc64，pass2 逐窗口重读
// x/residual 应用 γ/β），但 GM 侧改用逐窗口 DataCopyPad：行首/行尾落在 32B 块
// 中间时精确拷贝有效字节、把窗口尾部补零到向量粒度（per32），UB 内向量运算全程
// 对齐；γ/β 按 STRIPE 列分块流式读入，只有跨行尾 D 边界的子块做“精确拷贝+补零”，
// 避免越界读；输出按每窗口真实长度 DataCopyPad 精确写回（不给行尾补写）。
// ============================================================================
template <typename T>
class AddRmsNormBiasPadWide {
public:
    static constexpr uint32_t WIN = (sizeof(T) == sizeof(float)) ? 4096U : 8192U;
    static constexpr uint32_t STRIPE = 2048;

    __aicore__ inline void Init(GM_ADDR xGm, GM_ADDR rGm, GM_ADDR gGm, GM_ADDR bGm, GM_ADDR yGm,
                                const AddRmsNormBiasTilingData& tiling, TPipe* pipe) {
        pipe_ = pipe;
        D_ = tiling.D;
        epsilon_ = tiling.epsilon;
        invD_ = tiling.invD;
        uint32_t blockIdx = GetBlockIdx();
        uint32_t startRow = blockIdx * tiling.blockRows;
        uint32_t rowsLeft = (startRow < tiling.totalRows) ? (tiling.totalRows - startRow) : 0;
        rowCount_ = (rowsLeft < tiling.blockRows) ? rowsLeft : tiling.blockRows;
        elemStart_ = startRow * D_;
        totalElems_ = tiling.totalRows * D_;

        xG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(xGm), totalElems_);
        rG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(rGm), totalElems_);
        yG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(yGm), totalElems_);
        gG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gGm), D_);
        bG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bGm), D_);

        pipe_->InitBuffer(bufXg_, WIN * sizeof(T));
        pipe_->InitBuffer(bufRg_, WIN * sizeof(T));
        pipe_->InitBuffer(bufOg_, WIN * sizeof(T));
        pipe_->InitBuffer(bufXgB_, WIN * sizeof(T));
        pipe_->InitBuffer(bufRgB_, WIN * sizeof(T));
        pipe_->InitBuffer(bufYf_, WIN * sizeof(float));
        pipe_->InitBuffer(bufWk_, WIN * sizeof(float));
        pipe_->InitBuffer(bufAcc64_, 64 * sizeof(float));
        pipe_->InitBuffer(bufSum_, 64 * sizeof(float));
        pipe_->InitBuffer(bufGt_, STRIPE * sizeof(T));
        pipe_->InitBuffer(bufBt_, STRIPE * sizeof(T));
        pipe_->InitBuffer(bufGf_, STRIPE * sizeof(float));
        pipe_->InitBuffer(bufBf_, STRIPE * sizeof(float));

        xg_ = bufXg_.template Get<T>();
        rg_ = bufRg_.template Get<T>();
        og_ = bufOg_.template Get<T>();
        xgB_ = bufXgB_.template Get<T>();
        rgB_ = bufRgB_.template Get<T>();
        yf_ = bufYf_.Get<float>();
        wk_ = bufWk_.Get<float>();
        acc64_ = bufAcc64_.Get<float>();
        sum_ = bufSum_.Get<float>();
        gt_ = bufGt_.template Get<T>();
        bt_ = bufBt_.template Get<T>();
        gf_ = bufGf_.Get<float>();
        bf_ = bufBf_.Get<float>();
    }

    __aicore__ inline void Process() {
        uint32_t baseRow = elemStart_ / D_;
        for (uint32_t r = 0; r < rowCount_; r++) {
            UltraPadRow(baseRow + r);
        }
    }

private:
    // 单窗口真实长度 len 的向量处理长度：上取整到 per32（fp16/bf16 16、fp32 8）
    __aicore__ inline uint32_t VecLen(uint32_t len) {
        uint32_t per32 = DtypeOps<T>::Per32();
        return ((len + per32 - 1U) / per32) * per32;
    }

    // GM 窗口 -> UB（精确 len 元素，尾部补零到 vlen；同步版带屏障）
    __aicore__ inline void LoadWinPad(LocalTensor<T> xb, LocalTensor<T> rb, uint32_t gmOff,
                                      uint32_t len, uint32_t vlen) {
        PipeBarrier<PIPE_ALL>();
        LoadWinPadCore(xb, rb, gmOff, len, vlen);
        PipeBarrier<PIPE_ALL>();
    }
    __aicore__ inline void LoadWinPadAsync(LocalTensor<T> xb, LocalTensor<T> rb, uint32_t gmOff,
                                           uint32_t len, uint32_t vlen) {
        LoadWinPadCore(xb, rb, gmOff, len, vlen);
    }
    __aicore__ inline void LoadWinPadCore(LocalTensor<T> xb, LocalTensor<T> rb, uint32_t gmOff,
                                          uint32_t len, uint32_t vlen) {
        DataCopyExtParams cp;
        cp.blockCount = 1;
        cp.blockLen = len * static_cast<uint32_t>(sizeof(T));
        cp.srcStride = 0;
        cp.dstStride = 0;
        cp.rsv = 0;
        DataCopyPadExtParams<T> pp;
        pp.isPad = true;
        pp.leftPadding = 0;
        pp.rightPadding = vlen - len;
        pp.paddingValue = T(0);
        DataCopyPad(xb, xG_[gmOff], cp, pp);
        DataCopyPad(rb, rG_[gmOff], cp, pp);
    }

    // UB 窗口（fp32 yf_/经 og_ 转换）-> GM：只写 len 个真实元素，行尾不补写
    __aicore__ inline void StoreWinPad(uint32_t gmOff, uint32_t len, TrueType) {
        PipeBarrier<PIPE_ALL>();
        DataCopyExtParams cp;
        cp.blockCount = 1;
        cp.blockLen = len * static_cast<uint32_t>(sizeof(T));
        cp.srcStride = 0;
        cp.dstStride = 0;
        cp.rsv = 0;
        DataCopyPad(yG_[gmOff], yf_, cp);
        PipeBarrier<PIPE_ALL>();
    }
    __aicore__ inline void StoreWinPad(uint32_t gmOff, uint32_t len, FalseType) {
        DtypeOps<T>::Store(og_, yf_, len);   // fp16/bf16 先 round 回原类型（len 为真实元素）
        PipeBarrier<PIPE_ALL>();
        DataCopyExtParams cp;
        cp.blockCount = 1;
        cp.blockLen = len * static_cast<uint32_t>(sizeof(T));
        cp.srcStride = 0;
        cp.dstStride = 0;
        cp.rsv = 0;
        DataCopyPad(yG_[gmOff], og_, cp);
        PipeBarrier<PIPE_ALL>();
    }

    // pass1：sq(x+r) -> wk_（fp16/bf16 先升 fp32）
    __aicore__ inline void ComputeYsqPad(LocalTensor<T> xc, LocalTensor<T> rc, uint32_t vlen, FalseType) {
        DtypeOps<T>::ToFp32(xc, yf_, vlen);
        DtypeOps<T>::ToFp32(rc, wk_, vlen);
        Add(yf_, yf_, wk_, vlen);
        PipeBarrier<PIPE_V>();
        Mul(wk_, yf_, yf_, vlen);
        PipeBarrier<PIPE_V>();
    }
    __aicore__ inline void ComputeYsqPad(LocalTensor<T> xc, LocalTensor<T> rc, uint32_t vlen, TrueType) {
        Add(yf_, xc, rc, vlen);
        PipeBarrier<PIPE_V>();
        Mul(wk_, yf_, yf_, vlen);
        PipeBarrier<PIPE_V>();
    }
    // pass2：y=(x+r)*rstd -> yf_（vlen 含尾部补零区）
    __aicore__ inline void ComputeYfPad(LocalTensor<T> xc, LocalTensor<T> rc, uint32_t vlen, FalseType) {
        DtypeOps<T>::ToFp32(xc, yf_, vlen);
        DtypeOps<T>::ToFp32(rc, wk_, vlen);
        Add(yf_, yf_, wk_, vlen);
        PipeBarrier<PIPE_V>();
        Muls(yf_, yf_, rstd_, vlen);
        PipeBarrier<PIPE_V>();
    }
    __aicore__ inline void ComputeYfPad(LocalTensor<T> xc, LocalTensor<T> rc, uint32_t vlen, TrueType) {
        Add(yf_, xc, rc, vlen);
        PipeBarrier<PIPE_V>();
        Muls(yf_, yf_, rstd_, vlen);
        PipeBarrier<PIPE_V>();
    }

    // wk_[0,len) 就地树形归约到行首 64 lane
    __aicore__ inline void FoldHead64(LocalTensor<float> buf, uint32_t len) {
        uint32_t body = 1U;
        while ((body << 1) <= len) {
            body <<= 1;
        }
        uint32_t tail = len - body;
        if (tail != 0) {
            Add(buf, buf, buf[body], tail);
            PipeBarrier<PIPE_V>();
        }
        while (body > 64U) {
            body >>= 1;
            Add(buf, buf, buf[body], body);
            PipeBarrier<PIPE_V>();
        }
    }

    // γ/β 的 [gcol, gcol+avail) 精确段 -> UB 并转 fp32（尾部补零到 len），
    // 或 [gcol, gcol+len) 对齐段直接 DataCopy（len 为 STRIPE/窗口边界，32B 对齐）。
    __aicore__ inline void LoadGB(uint32_t gcol, uint32_t avail, uint32_t len, FalseType) {
        PipeBarrier<PIPE_ALL>();
        if (avail == len) {
            DataCopy(gt_, gG_[gcol], len);
            DataCopy(bt_, bG_[gcol], len);
        } else {
            DataCopyExtParams cp;
            cp.blockCount = 1;
            cp.blockLen = avail * static_cast<uint32_t>(sizeof(T));
            cp.srcStride = 0;
            cp.dstStride = 0;
            cp.rsv = 0;
            DataCopyPadExtParams<T> pp;
            pp.isPad = true;
            pp.leftPadding = 0;
            pp.rightPadding = len - avail;
            pp.paddingValue = T(0);
            DataCopyPad(gt_, gG_[gcol], cp, pp);
            DataCopyPad(bt_, bG_[gcol], cp, pp);
        }
        PipeBarrier<PIPE_ALL>();
        gf_ = DtypeOps<T>::ToFp32(gt_, gf_, len);
        bf_ = DtypeOps<T>::ToFp32(bt_, bf_, len);
    }
    __aicore__ inline void LoadGB(uint32_t gcol, uint32_t avail, uint32_t len, TrueType) {
        PipeBarrier<PIPE_ALL>();
        if (avail == len) {
            DataCopy(gt_, gG_[gcol], len);
            DataCopy(bt_, bG_[gcol], len);
        } else {
            DataCopyExtParams cp;
            cp.blockCount = 1;
            cp.blockLen = avail * static_cast<uint32_t>(sizeof(T));
            cp.srcStride = 0;
            cp.dstStride = 0;
            cp.rsv = 0;
            DataCopyPadExtParams<T> pp;
            pp.isPad = true;
            pp.leftPadding = 0;
            pp.rightPadding = len - avail;
            pp.paddingValue = T(0);
            DataCopyPad(gt_, gG_[gcol], cp, pp);
            DataCopyPad(bt_, bG_[gcol], cp, pp);
        }
        PipeBarrier<PIPE_ALL>();
        gf_ = gt_;
        bf_ = bt_;
    }

    // 整行两遍窗口化（gmBase = row*D 元素偏移）
    __aicore__ inline void UltraPadRow(uint32_t rowG) {
        uint32_t per32 = DtypeOps<T>::Per32();
        uint32_t nWin = (D_ + WIN - 1U) / WIN;
        uint32_t gmBase = rowG * D_;

        // ---- pass1：逐窗口 sq -> fold 进 acc64_（双缓冲预取）----
        Duplicate(acc64_, 0.0f, 64);
        PipeBarrier<PIPE_V>();
        {
            uint32_t len0 = (D_ >= WIN) ? WIN : D_;
            LoadWinPad(xg_, rg_, gmBase, len0, VecLen(len0));
        }
        for (uint32_t w = 0; w < nWin; w++) {
            uint32_t col = w * WIN;
            uint32_t len = (D_ - col < WIN) ? (D_ - col) : WIN;
            uint32_t vlen = VecLen(len);
            LocalTensor<T> xc = ((w & 1U) == 0U) ? xg_ : xgB_;
            LocalTensor<T> rc = ((w & 1U) == 0U) ? rg_ : rgB_;
            if (w + 1 < nWin) {
                uint32_t ncol = (w + 1) * WIN;
                uint32_t nlen = (D_ - ncol < WIN) ? (D_ - ncol) : WIN;
                if ((w & 1U) == 0U) {
                    LoadWinPadAsync(xgB_, rgB_, gmBase + ncol, nlen, VecLen(nlen));
                } else {
                    LoadWinPadAsync(xg_, rg_, gmBase + ncol, nlen, VecLen(nlen));
                }
            }
            ComputeYsqPad(xc, rc, vlen, typename DtypeOps<T>::IsFloat());
            if (vlen >= 64U) {
                FoldHead64(wk_, vlen);
                Add(acc64_, acc64_, wk_, 64);
            } else {
                Add(acc64_, acc64_, wk_, vlen);
            }
            PipeBarrier<PIPE_ALL>();
        }

        // 整行 sum -> rstd
        WholeReduceSum<float, true>(sum_, acc64_, 64, 1, 0, 1, 0);
        Muls(sum_, sum_, invD_, 1);
        Adds(sum_, sum_, epsilon_, 1);
        Sqrt(sum_, sum_, 1);
        Duplicate(wk_, 1.0f, 1);
        Div(sum_, wk_, sum_, 1);
        PipeBarrier<PIPE_V>();
        SyncV2S();
        rstd_ = sum_.GetValue(0);
        SyncS2V();

        // ---- pass2：逐窗口重读 x/residual，乘 rstd，流式应用 γ/β 并写回 ----
        {
            uint32_t len0 = (D_ >= WIN) ? WIN : D_;
            LoadWinPad(xg_, rg_, gmBase, len0, VecLen(len0));
        }
        for (uint32_t w = 0; w < nWin; w++) {
            uint32_t col = w * WIN;
            uint32_t len = (D_ - col < WIN) ? (D_ - col) : WIN;
            uint32_t vlen = VecLen(len);
            LocalTensor<T> xc = ((w & 1U) == 0U) ? xg_ : xgB_;
            LocalTensor<T> rc = ((w & 1U) == 0U) ? rg_ : rgB_;
            if (w + 1 < nWin) {
                uint32_t ncol = (w + 1) * WIN;
                uint32_t nlen = (D_ - ncol < WIN) ? (D_ - ncol) : WIN;
                if ((w & 1U) == 0U) {
                    LoadWinPadAsync(xgB_, rgB_, gmBase + ncol, nlen, VecLen(nlen));
                } else {
                    LoadWinPadAsync(xg_, rg_, gmBase + ncol, nlen, VecLen(nlen));
                }
            }
            ComputeYfPad(xc, rc, vlen, typename DtypeOps<T>::IsFloat());
            uint32_t sub = 0;
            while (sub < vlen) {
                uint32_t want = vlen - sub;
                if (want > STRIPE) {
                    want = STRIPE;
                }
                uint32_t gcol = col + sub;   // 全局列（与 gamma/bias 对齐）
                uint32_t end = gcol + want;
                uint32_t avail = (end <= D_) ? want : ((gcol < D_) ? (D_ - gcol) : 0U);
                LoadGB(gcol, avail, want, typename DtypeOps<T>::IsFloat());
                FusedMulAdd(yf_[sub], gf_, bf_, want);
                PipeBarrier<PIPE_V>();
                sub += want;
            }
            StoreWinPad(gmBase + col, len, typename DtypeOps<T>::IsFloat());
            if (w + 1 < nWin) {
                PipeBarrier<PIPE_ALL>();
            }
        }
    }

    __aicore__ inline void SyncV2S() {
        event_t ev = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(ev);
        WaitFlag<HardEvent::V_S>(ev);
    }
    __aicore__ inline void SyncS2V() {
        event_t ev = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));
        SetFlag<HardEvent::S_V>(ev);
        WaitFlag<HardEvent::S_V>(ev);
    }

private:
    TPipe* pipe_ = nullptr;
    uint32_t rowCount_ = 0;
    uint32_t elemStart_ = 0;
    uint32_t totalElems_ = 0;
    uint32_t D_ = 0;
    float epsilon_ = 1e-5f;
    float invD_ = 0.0f;
    float rstd_ = 0.0f;

    GlobalTensor<T> xG_;
    GlobalTensor<T> rG_;
    GlobalTensor<T> gG_;
    GlobalTensor<T> bG_;
    GlobalTensor<T> yG_;

    TBuf<TPosition::VECIN> bufXg_, bufRg_, bufOg_, bufXgB_, bufRgB_;
    TBuf<TPosition::VECIN> bufYf_, bufWk_, bufAcc64_, bufSum_;
    TBuf<TPosition::VECIN> bufGt_, bufBt_, bufGf_, bufBf_;

    LocalTensor<T> xg_, rg_, og_, gt_, bt_, xgB_, rgB_;
    LocalTensor<float> yf_, wk_, gf_, bf_, acc64_, sum_;
};

}  // namespace addrms

// ============================================================================
// device 核函数入口
// ============================================================================
extern "C" __global__ __vector__ void add_rms_norm_bias_custom(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
                                                               GM_ADDR bias, GM_ADDR output, GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;
    addrms::AddRmsNormBiasTilingData tiling;
    addrms::CopyTilingLocal(&tiling, tilingGm);

    if (tiling.group == 1U) {
        if (tiling.dtype == 1) {
            addrms::AddRmsNormBiasGroup<half> op;
            op.Init(x, residual, gamma, bias, output, tiling, &pipe);
            op.Process();
        } else if (tiling.dtype == 2) {
            addrms::AddRmsNormBiasGroup<bfloat16_t> op;
            op.Init(x, residual, gamma, bias, output, tiling, &pipe);
            op.Process();
        } else {
            addrms::AddRmsNormBiasGroup<float> op;
            op.Init(x, residual, gamma, bias, output, tiling, &pipe);
            op.Process();
        }
        return;
    }
    if (tiling.group == 2U) {
        if (tiling.dtype == 1) {
            addrms::AddRmsNormBiasPad<half> op;
            op.Init(x, residual, gamma, bias, output, tiling, &pipe);
            op.Process();
        } else if (tiling.dtype == 2) {
            addrms::AddRmsNormBiasPad<bfloat16_t> op;
            op.Init(x, residual, gamma, bias, output, tiling, &pipe);
            op.Process();
        } else {
            addrms::AddRmsNormBiasPad<float> op;
            op.Init(x, residual, gamma, bias, output, tiling, &pipe);
            op.Process();
        }
        return;
    }
    if (tiling.group == 3U) {
        if (tiling.dtype == 1) {
            addrms::AddRmsNormBiasPadWide<half> op;
            op.Init(x, residual, gamma, bias, output, tiling, &pipe);
            op.Process();
        } else if (tiling.dtype == 2) {
            addrms::AddRmsNormBiasPadWide<bfloat16_t> op;
            op.Init(x, residual, gamma, bias, output, tiling, &pipe);
            op.Process();
        } else {
            addrms::AddRmsNormBiasPadWide<float> op;
            op.Init(x, residual, gamma, bias, output, tiling, &pipe);
            op.Process();
        }
        return;
    }
    if (tiling.dtype == 1) {
        addrms::AddRmsNormBiasKernel<half> op;
        op.Init(x, residual, gamma, bias, output, tiling, &pipe);
        op.Process();
    } else if (tiling.dtype == 2) {
        addrms::AddRmsNormBiasKernel<bfloat16_t> op;
        op.Init(x, residual, gamma, bias, output, tiling, &pipe);
        op.Process();
    } else {
        addrms::AddRmsNormBiasKernel<float> op;
        op.Init(x, residual, gamma, bias, output, tiling, &pipe);
        op.Process();
    }
}

// ============================================================================
// host 侧启动函数
// ============================================================================
extern "C" void AddRmsNormBiasTilingPrepare(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR residual,
                           const TensorGroupInfo& info_residual, GM_ADDR gamma, const TensorGroupInfo& info_gamma,
                           GM_ADDR bias, const TensorGroupInfo& info_bias, GM_ADDR output,
                           const TensorGroupInfo& info_output, int64_t availableCoreNum, aclrtStream stream,
                           float epsilon, uint32_t* outBlockNum)
{
    const int64_t* shape = info_x.tensors[0].shape;
    int64_t numDims = info_x.tensors[0].numDims;
    int32_t dtype = info_x.tensors[0].dtype;
    if (numDims < 2) {
        return;
    }
    int64_t D = shape[numDims - 1];
    if (D <= 0) {
        return;
    }
    if (dtype != 0 && dtype != 1 && dtype != 2) {
        return;
    }

    int64_t totalElems = 1;
    for (int64_t i = 0; i < numDims; i++) {
        totalElems *= shape[i];
    }
    int64_t totalRows = totalElems / D;

    int64_t blockNum = (totalRows < availableCoreNum) ? totalRows : availableCoreNum;
    if (blockNum < 1) {
        blockNum = 1;
    }
    uint32_t blockRows = static_cast<uint32_t>((totalRows + blockNum - 1) / blockNum);

    addrms::AddRmsNormBiasTilingData tiling;
    tiling.dtype = dtype;
    tiling.totalRows = static_cast<uint32_t>(totalRows);
    tiling.D = static_cast<uint32_t>(D);
    tiling.blockRows = blockRows;
    tiling.epsilon = epsilon;
    tiling.invD = 1.0f / static_cast<float>(D);
    // 路径分派：
    //   group1 对齐行批量路径——行首在 fp32 工作区 32B 对齐（fp16/bf16
    //   D%16==0、fp32 D%8==0）且 64<=D<=32768（fp16/bf16/fp32 统一上限）。
    //   group2 非对齐行 padded 路径——非对齐且 64<=D<=2048（D=100/104/136...）。
    //   其余（非对齐 D>2048 的宽行、D<64）走 AddRmsNormBiasKernel 逐行保底。
    uint32_t aligned = (dtype == 0) ? (static_cast<uint32_t>(D) % 8U == 0U)
                                    : (static_cast<uint32_t>(D) % 16U == 0U);
    uint32_t dmax = 32768U;
    if (aligned && D >= 64 && D <= dmax) {
        tiling.group = 1U;
    } else if (!aligned && D >= 64 && D <= 2048) {
        tiling.group = 2U;
    } else if (!aligned && D >= 64 && D <= dmax) {
        tiling.group = 3U;   // 非对齐宽行 padded 窗口路径（#11/#13 类）
    } else {
        tiling.group = 0U;
    }

    // tiling 设备缓冲按内容在进程内缓存：同内容复用（本地重复计时时避免
    // 每轮 H2D host 开销）；内容变化则分配独立缓冲上传，绝不覆盖/释放可能
    // 仍被上一个 kernel 读取的缓冲，保证同进程顺序跑多个不同 case 的正确性。
    constexpr uint32_t kTilingWords = sizeof(addrms::AddRmsNormBiasTilingData) / sizeof(uint32_t);
    const uint32_t* tilingWords = reinterpret_cast<const uint32_t*>(&tiling);
    struct TilingSlot {
        void* dev;
        uint32_t key[kTilingWords];
        bool used;
    };
    static TilingSlot sPool[16];
    static uint32_t sPoolCount = 0;

    void* tilingDev = nullptr;
    for (uint32_t s = 0; s < sPoolCount; s++) {
        bool eq = true;
        for (uint32_t i = 0; i < kTilingWords; i++) {
            if (sPool[s].key[i] != tilingWords[i]) {
                eq = false;
                break;
            }
        }
        if (eq) {
            tilingDev = sPool[s].dev;
            break;
        }
    }
    if (tilingDev == nullptr) {
        void* dev = nullptr;
        if (aclrtMalloc(&dev, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
            return;
        }
        if (aclrtMemcpy(dev, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE) != 0) {
            return;
        }
        uint32_t slot = sPoolCount;
        if (slot >= 16U) {
            // 理论兜底（池满且内容全新）：同步后再覆盖最旧槽位，保证无读写竞态
            aclrtSynchronizeStream(stream);
            slot = 0U;
        }
        sPool[slot].dev = dev;
        sPool[slot].used = true;
        for (uint32_t i = 0; i < kTilingWords; i++) {
            sPool[slot].key[i] = tilingWords[i];
        }
        if (sPoolCount < 16U) {
            sPoolCount++;
        }
        tilingDev = dev;
    }

    add_rms_norm_bias_custom<<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(x, residual, gamma, bias, output,
                                                                                  (GM_ADDR)tilingDev);
    if (outBlockNum != nullptr) {
        *outBlockNum = static_cast<uint32_t>(blockNum);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR residual,
                           const TensorGroupInfo& info_residual, GM_ADDR gamma, const TensorGroupInfo& info_gamma,
                           GM_ADDR bias, const TensorGroupInfo& info_bias, GM_ADDR output,
                           const TensorGroupInfo& info_output, int64_t availableCoreNum, aclrtStream stream,
                           float epsilon)
{
    AddRmsNormBiasTilingPrepare(x, info_x, residual, info_residual, gamma, info_gamma, bias, info_bias, output,
                                info_output, availableCoreNum, stream, epsilon, nullptr);
    aclrtSynchronizeStream(stream);  // 同步等待内核完成（tiling 缓冲进程内复用）
}

// 仅入队不等待（本地批量计时用）
extern "C" void run_kernel_nosync(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR residual,
                                  const TensorGroupInfo& info_residual, GM_ADDR gamma, const TensorGroupInfo& info_gamma,
                                  GM_ADDR bias, const TensorGroupInfo& info_bias, GM_ADDR output,
                                  const TensorGroupInfo& info_output, int64_t availableCoreNum, aclrtStream stream,
                                  float epsilon)
{
    AddRmsNormBiasTilingPrepare(x, info_x, residual, info_residual, gamma, info_gamma, bias, info_bias, output,
                                info_output, availableCoreNum, stream, epsilon, nullptr);
}
