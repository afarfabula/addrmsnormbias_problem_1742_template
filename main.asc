// Local test main — 从 input/case.bin 读取形状/类型，运行 AddRmsNormBias kernel
// Usage: ./add_rms_norm_bias_custom
// 输入约定:
//   input/case.bin   CaseConfig(shape, numDims, dtype, epsilon)
//   input/x.bin / residual.bin / gamma.bin / bias.bin
//   output/output.bin

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

struct CaseConfig {
    int64_t numDims;
    int64_t shape[8];
    int32_t dtype;
    float epsilon;
};

#include "kernel.asc"

int main()
{
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    // ---- 读取 case 配置 ----
    CaseConfig cfg;
    FILE_CHECK(ReadFile("./input/case.bin", sizeof(CaseConfig), &cfg, sizeof(CaseConfig)));
    int64_t numDims = cfg.numDims;
    if (numDims < 1 || numDims > 8) {
        fprintf(stderr, "[ERROR] bad numDims=%lld\n", (long long)numDims);
        return 1;
    }
    int32_t dtype = cfg.dtype;
    if (dtype != 0 && dtype != 1 && dtype != 2) {
        fprintf(stderr, "[ERROR] bad dtype=%d\n", (int)dtype);
        return 1;
    }
    int64_t D = cfg.shape[numDims - 1];
    int64_t totalElems = 1;
    for (int64_t i = 0; i < numDims; i++) {
        totalElems *= cfg.shape[i];
    }
    if (D <= 0 || totalElems <= 0) {
        fprintf(stderr, "[ERROR] bad shape\n");
        return 1;
    }
    int64_t dtypeSize = (dtype == 0) ? 4 : 2;
    size_t tensorBytes = static_cast<size_t>(totalElems) * static_cast<size_t>(dtypeSize);
    size_t paramBytes = static_cast<size_t>(D) * static_cast<size_t>(dtypeSize);
    fprintf(stderr, "[RUN] shape=(%lld,%lld,...) D=%lld dtype=%d totalElems=%lld bytes=%zu\n",
            (long long)cfg.shape[0], (long long)cfg.shape[1], (long long)D, (int)dtype,
            (long long)totalElems, tensorBytes);

    int64_t x_0_shape[8], residual_0_shape[8], gamma_0_shape[8], bias_0_shape[8], output_0_shape[8];
    for (int64_t i = 0; i < numDims; i++) {
        x_0_shape[i] = residual_0_shape[i] = bias_0_shape[i] = output_0_shape[i] = cfg.shape[i];
    }
    gamma_0_shape[0] = D;
    TensorInfo x_tensors[] = {{x_0_shape, numDims, dtype}};
    TensorGroupInfo info_x = {x_tensors, 1};
    TensorInfo residual_tensors[] = {{residual_0_shape, numDims, dtype}};
    TensorGroupInfo info_residual = {residual_tensors, 1};
    TensorInfo gamma_tensors[] = {{gamma_0_shape, 1, dtype}};
    TensorGroupInfo info_gamma = {gamma_tensors, 1};
    TensorInfo bias_tensors[] = {{bias_0_shape, 1, dtype}};
    TensorGroupInfo info_bias = {bias_tensors, 1};
    TensorInfo output_tensors[] = {{output_0_shape, numDims, dtype}};
    TensorGroupInfo info_output = {output_tensors, 1};

    float epsilon = cfg.epsilon;

    uint8_t *inputHost_x = nullptr, *inputDevice_x = nullptr;
    uint8_t *inputHost_residual = nullptr, *inputDevice_residual = nullptr;
    uint8_t *inputHost_gamma = nullptr, *inputDevice_gamma = nullptr;
    uint8_t *inputHost_bias = nullptr, *inputDevice_bias = nullptr;
    uint8_t *outputHost_output = nullptr, *outputDevice_output = nullptr;

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x, tensorBytes));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x, tensorBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x.bin", tensorBytes, inputHost_x, tensorBytes));
    ACL_CHECK(aclrtMemcpy(inputDevice_x, tensorBytes, inputHost_x, tensorBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_residual, tensorBytes));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_residual, tensorBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/residual.bin", tensorBytes, inputHost_residual, tensorBytes));
    ACL_CHECK(aclrtMemcpy(inputDevice_residual, tensorBytes, inputHost_residual, tensorBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_gamma, paramBytes));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_gamma, paramBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/gamma.bin", paramBytes, inputHost_gamma, paramBytes));
    ACL_CHECK(aclrtMemcpy(inputDevice_gamma, paramBytes, inputHost_gamma, paramBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_bias, paramBytes));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_bias, paramBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/bias.bin", paramBytes, inputHost_bias, paramBytes));
    ACL_CHECK(aclrtMemcpy(inputDevice_bias, paramBytes, inputHost_bias, paramBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&outputHost_output, tensorBytes));
    ACL_CHECK(aclrtMalloc((void **)&outputDevice_output, tensorBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    run_kernel((GM_ADDR)inputDevice_x, info_x, (GM_ADDR)inputDevice_residual, info_residual,
               (GM_ADDR)inputDevice_gamma, info_gamma, (GM_ADDR)inputDevice_bias, info_bias,
               (GM_ADDR)outputDevice_output, info_output, availableCoreNum, stream, epsilon);
    auto sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 3000);
    if (sync_ret_ != 0) {
        fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", sync_ret_);
        return 1;
    }

    ACL_CHECK(aclrtMemcpy(outputHost_output, tensorBytes, outputDevice_output, tensorBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/output.bin", outputHost_output, tensorBytes));

    if (inputDevice_x) aclrtFree(inputDevice_x);
    if (inputHost_x) aclrtFreeHost(inputHost_x);
    if (inputDevice_residual) aclrtFree(inputDevice_residual);
    if (inputHost_residual) aclrtFreeHost(inputHost_residual);
    if (inputDevice_gamma) aclrtFree(inputDevice_gamma);
    if (inputHost_gamma) aclrtFreeHost(inputHost_gamma);
    if (inputDevice_bias) aclrtFree(inputDevice_bias);
    if (inputHost_bias) aclrtFreeHost(inputHost_bias);
    if (outputDevice_output) aclrtFree(outputDevice_output);
    if (outputHost_output) aclrtFreeHost(outputHost_output);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
