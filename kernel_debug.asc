// ============================================================================
// kernel_debug.asc — 最小化调试 kernel，只写常数输出验证启动链路
// ============================================================================
#include <cstdint>
#include "kernel_operator.h"
#include <cstdio>

using namespace AscendC;

// 直写常数 kernel —— 测试启动链路
extern "C" __global__ __vector__ void test_write_kernel(GM_ADDR output, GM_ADDR tilingGm)
{
    // 读 tiling 数据（D=元素数）
    const __gm__ uint32_t* tiling = reinterpret_cast<const __gm__ uint32_t*>(tilingGm);
    uint32_t D = tiling[0];  // 第一个 uint32 是 D

    TPipe pipe;
    // 分配 UB buffer
    LocalTensor<half> outLocal;
    pipe.InitBuffer(outLocal, D);
    
    // 写常数 1.0
    Duplicate(outLocal, half(1.0f), D);
    PipeBarrier<PIPE_V>();
    
    // 写回 GM
    GlobalTensor<half> outGlobal;
    outGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(output), D);
    DataCopy(outGlobal, outLocal, D);
}

// host 侧启动函数
extern "C" void run_test_write(GM_ADDR output, uint32_t D, aclrtStream stream)
{
    // 准备 tiling（只传 D）
    uint32_t tilingHost = D;
    void* tilingDev = nullptr;
    if (aclrtMalloc(&tilingDev, sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
        fprintf(stderr, "[DEBUG] aclrtMalloc tiling failed\n");
        return;
    }
    if (aclrtMemcpy(tilingDev, sizeof(uint32_t), &tilingHost, sizeof(uint32_t), ACL_MEMCPY_HOST_TO_DEVICE) != 0) {
        fprintf(stderr, "[DEBUG] aclrtMemcpy tiling failed\n");
        aclrtFree(tilingDev);
        return;
    }

    fprintf(stderr, "[DEBUG] Launching test_write_kernel with D=%u\n", D);
    test_write_kernel<<<1, nullptr, stream>>>(output, (GM_ADDR)tilingDev);
    aclError syncRet = aclrtSynchronizeStream(stream);
    if (syncRet != 0) {
        fprintf(stderr, "[DEBUG] aclrtSynchronizeStream failed: %d\n", syncRet);
    } else {
        fprintf(stderr, "[DEBUG] Kernel completed successfully\n");
    }
    aclrtFree(tilingDev);
}